procedure clear_lvars begin
   DropProcActive = 0;
   gTimerTarget = 0;
   call cancel_timed_check_set_fid;
end

procedure check_set_fid begin
   variable critter;
   variable was_set;
   variable fid;
   variable no_wpn_fid;
   variable anim_art;
   foreach critter in check_fid_arr begin
      fid = obj_art_fid(critter);
      no_wpn_fid = critter_art_fid(critter);
      anim_art = art_anim(fid);
      if fid != no_wpn_fid andAlso (anim_art == 0 orElse anim_art == ANIM_fall_back_sf orElse anim_art == ANIM_fall_front_sf) then begin
         was_set = 1;
         set_object_data(critter, OBJ_DATA_FID, no_wpn_fid);
      end
   end
   if was_set then
      tile_refresh_display;
end

procedure add_timed_check_set_fid(variable critter) begin
   if (gTimerTarget1 == 0) then begin
      gTimerTarget1 = critter;
      call add_timed_check_set_fid1 when (art_anim(obj_art_fid(gTimerTarget1)) == 0);
      return;
   end
   if (gTimerTarget2 == 0) then begin
      gTimerTarget2 = critter;
