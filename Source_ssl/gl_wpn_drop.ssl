procedure Drop_Weapons(variable target,variable hand) begin
   variable weapon;
   variable weapon_pid;
   variable weapon_anim = -1;
   variable weapon_rh_flags_ext;
   variable weapon_lh_flags_ext;
   variable tar_pid;
   variable tar_hex;
   variable tar_critter_type;
   variable tar_critter_flags;
   variable dropped_hex;
   variable blocking_obj;
   variable count;
   variable max_count = 6;
   //variable is_throwing_weapon = 1;
   if target <= 0 then
      return;

   tar_pid = obj_pid(target);
   tar_critter_flags = get_proto_data(tar_pid, PROTO_CR_FLAGS);

   if tar_critter_flags bwand CFLG_NODROP then
      return;

   tar_hex = tile_num(target);
   tar_critter_type = metarule(METARULE_CRITTER_KILL_TYPE, target);
   weapon = critter_inven_obj(target, INVEN_TYPE_RIGHT_HAND);
   if weapon > 0 then begin
      if obj_item_subtype(weapon) == item_type_weapon then begin
         weapon_pid = obj_pid(weapon);
         weapon_rh_flags_ext = get_proto_data(weapon_pid, PROTO_FLAG_EXT);
         weapon_anim = get_proto_data(weapon_pid, PROTO_WP_ANIM);
         //if weapon_anim <= WPN_ANIM_NONE andAlso get_proto_data(weapon_pid, PROTO_WP_PROJ_PID) > 0 then
            //is_throwing_weapon = 1;
         //if not (weapon_anim > WPN_ANIM_NONE orElse is_throwing_weapon) then
            //return;
      end

      if (DropAnyItem > 0 andAlso hand == BODY_HIT_RIGHT_ARM) orElse (weapon_anim >= WPN_ANIM_NONE andAlso ((hand == BODY_HIT_RIGHT_ARM) orElse ((weapon_rh_flags_ext bwand WEAPON_2HAND) andAlso (not(tar_critter_type == KILL_TYPE_super_mutant_kills andAlso (weapon_anim == WPN_ANIM_MINIGUN orElse weapon_anim == WPN_ANIM_ROCKET_LAUNCHER)))))) then begin
         rm_obj_from_inven(target, weapon);
         dropped_hex = tile_num_in_direction(tar_hex, random(0, 5), random(1, 3));
         blocking_obj = obj_blocking_line(target, dropped_hex, BLOCKING_TYPE_SHOOT);
         if blocking_obj andAlso obj_type(blocking_obj) == OBJ_TYPE_CRITTER then blocking_obj = 0;
         while (tile_contains_obj_pid(dropped_hex, elevation(target), 33554499) != 0) or blocking_obj do begin
            dropped_hex = tile_num_in_direction(tar_hex, random(0, 5), random(1, 3));
            count += 1;
            blocking_obj = obj_blocking_line(target, dropped_hex, BLOCKING_TYPE_BLOCK);
            if blocking_obj andAlso obj_type(blocking_obj) == OBJ_TYPE_CRITTER then blocking_obj = 0;
            if count > max_count then begin
               dropped_hex = tar_hex;
               break;
            end
         end
         move_to(weapon, dropped_hex, elevation(target));
         set_array(check_fid_arr, len_array(check_fid_arr), target);
         call add_timed_check_set_fid(target);
         if target == dude_obj then
            intface_redraw;
      end
   end
   //all weapons in the game are either right-handed or two-handed, so the player drops weapon only if the shot was in the right hand
   else begin
      weapon = critter_inven_obj(target, INVEN_TYPE_LEFT_HAND);
      if weapon <= 0 then
         return;

      if obj_item_subtype(weapon) == item_type_weapon then begin
         weapon_pid = obj_pid(weapon);
         weapon_lh_flags_ext = get_proto_data(weapon_pid, PROTO_FLAG_EXT);
         weapon_anim = get_proto_data(weapon_pid, PROTO_WP_ANIM);
         //if weapon_anim <= WPN_ANIM_NONE andAlso get_proto_data(weapon_pid, PROTO_WP_PROJ_PID) > 0 then
            //is_throwing_weapon = 1;
         //if not (weapon_anim > WPN_ANIM_NONE orElse is_throwing_weapon) then
            //return;
      end
      if (DropAnyItem > 0 andAlso hand == BODY_HIT_LEFT_ARM) orElse (weapon_anim >= WPN_ANIM_NONE andAlso ((hand == BODY_HIT_RIGHT_ARM andAlso target == dude_obj) orElse (hand == BODY_HIT_LEFT_ARM andAlso target != dude_obj) orElse (weapon_lh_flags_ext bwand WEAPON_2HAND))) then begin
         rm_obj_from_inven(target, weapon);
         dropped_hex = tile_num_in_direction(tar_hex, random(0, 5), random(1, 3));
         blocking_obj = obj_blocking_line(target, dropped_hex, BLOCKING_TYPE_SHOOT);
         if blocking_obj andAlso obj_type(blocking_obj) == OBJ_TYPE_CRITTER then blocking_obj = 0;
         while (tile_contains_obj_pid(dropped_hex, elevation(target), 33554499) != 0) or blocking_obj do begin
            dropped_hex = tile_num_in_direction(tar_hex, random(0, 5), random(1, 3));
            count += 1;
            blocking_obj = obj_blocking_line(target, dropped_hex, BLOCKING_TYPE_BLOCK);
            if blocking_obj andAlso obj_type(blocking_obj) == OBJ_TYPE_CRITTER then blocking_obj = 0;
            if count > max_count then begin
               dropped_hex = tar_hex;
               break;
            end
         end
         move_to(weapon, dropped_hex, elevation(target));
         set_array(check_fid_arr, len_array(check_fid_arr), target);
         call add_timed_check_set_fid(target);
         if target == dude_obj then
            intface_redraw;
      end
   end
end

procedure calc_weapon_drop_chance(variable target, variable is_crit, variable is_party_member) begin
   variable chance;
   variable npc_mult;
   variable resist_mult;
   variable resist_val;
   variable victim_weapon;
   variable victim_weapon_pid;
   variable victim_weapon_flags;

   if is_crit then begin
      chance = WpnDropCrit;
      npc_mult = WeaponDropCriticalChanceNPCMultiplier;
   end
   else begin
      chance = WpnDropNonCrit;
      npc_mult = WeaponDropNonCriticalChanceNPCMultiplier;
   end

   if not(is_party_member) then
      chance = chance * npc_mult;

   if (combat_data > 0 andAlso get_object_data(combat_data, C_ATTACK_SOURCE) == dude_obj andAlso has_trait(TRAIT_TRAIT, dude_obj, TRAIT_finesse)) then
      chance = chance * WeaponDropFinesseMultiplier;

   resist_val = (get_critter_stat(target, STAT_en) + get_critter_stat(target, STAT_st) + get_critter_stat(target, STAT_ag) + get_critter_stat(target, STAT_lu) / 3.0) / 30.0;

   if resist_val >= 0.5556 then
      resist_mult = 1.0 - (resist_val - 0.5556) * 1.35;
   else
      resist_mult = 1.0 + (0.5556 - resist_val) * 4.5;

   if resist_mult > 3.0 then resist_mult = 3.0;
   if resist_mult < 0.25 then resist_mult = 0.25;

   chance = chance * resist_mult;

   if WeaponDropOneHanderDivMult != 0 andAlso target == dude_obj andAlso has_trait(TRAIT_TRAIT, dude_obj, TRAIT_one_hander) then begin
      victim_weapon = critter_inven_obj(target, INVEN_TYPE_RIGHT_HAND);
      if not(victim_weapon) then
         victim_weapon = critter_inven_obj(target, INVEN_TYPE_LEFT_HAND);

      if victim_weapon > 0 andAlso obj_item_subtype(victim_weapon) == item_type_weapon then begin
         victim_weapon_pid = obj_pid(victim_weapon);
         victim_weapon_flags = get_proto_data(victim_weapon_pid, PROTO_FLAG_EXT);

         if (victim_weapon_flags bwand WEAPON_2HAND) then
            chance = chance * WeaponDropOneHanderDivMult;
         else
            chance = chance / WeaponDropOneHanderDivMult;
      end
   end

   chance = ceil(chance);

   return chance;
end

procedure get_combat_attack_result(variable attacker_flags = -1) begin
   variable attack_result;
   if attacker_flags < 0 then begin
      if get_object_data(combat_data, C_ATTACK_TARGET) <= 0 then
         return -1;

      attacker_flags = get_object_data(combat_data, C_ATTACK_FLAGS_SOURCE);
   end

   if attacker_flags bwand DAM_HIT != 0 then begin
      if attacker_flags bwand DAM_CRITICAL != 0 then
         attack_result = CRITICAL_HIT;
      else
         attack_result = HIT;

   end
   else begin
      if attacker_flags bwand DAM_CRITICAL != 0 then begin
         attack_result = CRITICAL_MISS;
      end
      else
         attack_result = MISS;
   end

   return attack_result;
end

procedure setup_wpn_drop begin
   variable rnd;
   variable party;
   variable target_in_party;
   variable drop_chance;
   variable resist;
   variable mult;
   variable exp_target;
   variable weapon;
   variable target;
   variable target_body_part;
   variable attack_result;
   if combat_is_initialized then begin
      if combat_data > 0 then begin
         target = get_object_data(combat_data, C_ATTACK_TARGET);
         if target > 0 andAlso obj_type(target) == OBJ_TYPE_CRITTER then begin
            target_body_part = get_object_data(combat_data, C_ATTACK_BODY_PART);
            attack_result = get_combat_attack_result;
            if (target_body_part == BODY_HIT_LEFT_ARM orElse target_body_part == BODY_HIT_RIGHT_ARM) andAlso attack_result >= HIT then begin
               if (get_object_data(combat_data, C_ATTACK_FLAGS_TARGET) bwand DAM_DROP) then begin
                  rnd = -1;
                  drop_chance = 100;
               end
               else begin
                  if get_object_data(combat_data, C_ATTACK_DAMAGE_TARGET) > 0 then
                     rnd = random(0, 99);
                  else begin
                     rnd = -1;
                     drop_chance = -1;
                  end
               end

               if rnd >= 0 then begin
                  party = party_member_list(0);
                  target_in_party = is_in_array(target, party);
                  drop_chance = calc_weapon_drop_chance(target, attack_result == CRITICAL_HIT, target_in_party);
               end

               if rnd < drop_chance then begin
                  call Drop_Weapons(target, target_body_part);
               end
            end
         end
      end
      //aoe wpn drop
      if len_array(exp_rh_wpn_drop_critters_array) > 0 then begin
         foreach exp_target in exp_rh_wpn_drop_critters_array begin
            call Drop_Weapons(exp_target,BODY_HIT_RIGHT_ARM);
         end
         clear_array(exp_rh_wpn_drop_critters_array);
         exp_target = 0;
      end
      if len_array(exp_lh_wpn_drop_critters_array) > 0 then begin
         foreach exp_target in exp_lh_wpn_drop_critters_array begin
            call Drop_Weapons(exp_target,BODY_HIT_LEFT_ARM);
         end
         clear_array(exp_lh_wpn_drop_critters_array);
         exp_target = 0;
      end
   end
end

procedure add_timed_wpn_drop_ATTACK_END begin
   add_global_timer_event(0, timed_timed_wpn_drop_ATTACK_END);
end

procedure add_timed_wpn_drop begin
   add_global_timer_event(0, timed_wpn_drop);
end

procedure COMBATDAMAGE begin
   variable target = get_sfall_arg;
   variable attacker = get_sfall_arg;
   variable dmgtotar = get_sfall_arg;
   variable dmgtoatkr = get_sfall_arg;
   variable weapon = get_sfall_arg_at(6);
   variable attack_type = get_sfall_arg_at(11);
   variable attack_anim;
   variable target_type;
   variable rnd;
   variable wpnpid;
   variable wpn_dmg_type = -1;
   variable critter_type;
   variable attacker_type;
   variable target_curhp = 1;
   variable attacker_curhp = 1;
   variable target_en;
   variable target_st;
   variable target_pe;
   variable party;
   variable target_in_party;
   variable attacker_in_party;
   variable player_mult = 1;
   variable combat_diff;
   variable actual_target = get_object_data(combat_data, C_ATTACK_TARGET);
   variable actual_attack;
   variable wpn_drop_chance;
   variable cur_frm;
   variable wpn_proj_pid;
   if (attacker != dude_obj andAlso actual_target > 0) orElse (attacker == dude_obj) then begin
      actual_attack = 1;
   end

   if actual_attack > 0 then begin
      party = party_member_list(0);
      target_in_party = is_in_array(target, party);
      attacker_in_party = is_in_array(attacker, party);
      combat_diff = combat_difficulty;

      if weapon > 0 then begin
         wpnpid = obj_pid(weapon);
         wpn_dmg_type = get_proto_data(wpnpid, PROTO_WP_DMG_TYPE);
      end
      if target then begin
         target_type = obj_type(target);
         if target_type == OBJ_TYPE_CRITTER then begin
            critter_type = metarule(METARULE_CRITTER_KILL_TYPE, target);
         end
         else
            critter_type = -1;
      end
   //chance to cripple limbs with explosion
      if CrippleMod > 0 then begin // mod activation
         if target_in_party or target == dude_obj then begin
            player_mult = CripDiv;
            if combat_diff == 0 then player_mult = CripDiv * 3;
         end
         if weapon > 0 andAlso target_type == OBJ_TYPE_CRITTER then begin
               target_curhp = get_critter_stat(target, STAT_current_hp);
            // cripple for non robot target
            if player_mult > 0 andAlso (wpn_dmg_type == DMG_explosion or wpnpid == 26) andAlso critter_type > 0 andAlso critter_type != 10 andAlso ((dmgtotar > (target_curhp / 7)) or (dmgtotar > 0 andAlso not(random(0,200)))) then begin
               target_en = get_critter_stat(target, STAT_en);
               target_st = get_critter_stat(target, STAT_st);
               target_pe = get_critter_stat(target, STAT_pe);
               wpn_drop_chance = WpnDropCrit;
               rnd = random(0, ((60 + target_en * 4) * player_mult ));
               if rnd <= RLcrip then begin
                  critter_injure(target, DAM_CRIP_LEG_RIGHT);
               end
               rnd = random(0, ((60 + target_en * 4) * player_mult ));
               if rnd <= LLcrip then begin
                  critter_injure(target, DAM_CRIP_LEG_LEFT);
               end
               rnd = random(0, ((60 + target_st * 3) * player_mult ));
               if rnd <= RAcrip then begin
                  wpn_drop_chance = calc_weapon_drop_chance(target, true, target_in_party);
                  critter_injure(target, DAM_CRIP_ARM_RIGHT);
                  if dmgtotar < target_curhp andAlso random(0,99) < wpn_drop_chance then begin
                     if not(is_in_array(target,exp_rh_wpn_drop_critters_array)) then set_array(exp_rh_wpn_drop_critters_array, len_array(exp_rh_wpn_drop_critters_array), target);
                  end
               end
               rnd = random(0, ((60 + target_st * 4) * player_mult ));
               if rnd <= LAcrip then begin
                  if wpn_drop_chance == 0 then
                     wpn_drop_chance = calc_weapon_drop_chance(target, true, target_in_party);
                  critter_injure(target, DAM_CRIP_ARM_LEFT);
                  if dmgtotar < target_curhp andAlso random(0,99) < wpn_drop_chance then begin
                     if not(is_in_array(target,exp_lh_wpn_drop_critters_array)) then set_array(exp_lh_wpn_drop_critters_array, len_array(exp_lh_wpn_drop_critters_array), target);
                  end
               end
               rnd = random(0, ((60 + target_pe * 4) * player_mult ));
               if rnd <= Icrip then begin
                  critter_injure(target, DAM_BLIND);
               end
            end
            // criple for robot target
            if ((dmgtotar > 5 andAlso wpn_dmg_type == DMG_emp) or (dmgtotar > (target_curhp / 4) andAlso (wpn_dmg_type == DMG_explosion))) andAlso critter_type > 0 andAlso critter_type == 10 then begin
               rnd = random(0, ((60 + target_en * 4) * player_mult ));
               if rnd <= RLcrip then begin
                  critter_injure(target, DAM_CRIP_LEG_RIGHT);
               end
               rnd = random(0, ((60 + target_en * 4) * player_mult ));
               if rnd <= LLcrip then begin
                  critter_injure(target, DAM_CRIP_LEG_LEFT);
               end
               rnd = random(0, ((60 + target_st * 4) * player_mult ));
               if rnd <= RAcrip then begin
                  wpn_drop_chance = calc_weapon_drop_chance(target, true, target_in_party);
                  critter_injure(target, DAM_CRIP_ARM_RIGHT);
                  if dmgtotar < target_curhp andAlso random(0,99) < wpn_drop_chance then begin
                     if not(is_in_array(target,exp_rh_wpn_drop_critters_array)) then set_array(exp_rh_wpn_drop_critters_array, len_array(exp_rh_wpn_drop_critters_array), target);
                  end
               end
               rnd = random(0, ((60 + target_st * 4) * player_mult ));
               if rnd <= LAcrip then begin
                  if wpn_drop_chance == 0 then
                     wpn_drop_chance = calc_weapon_drop_chance(target, true, target_in_party);
                  critter_injure(target, DAM_CRIP_ARM_LEFT);
                  if dmgtotar < target_curhp andAlso random(0,99) < wpn_drop_chance then begin
                     if not(is_in_array(target,exp_lh_wpn_drop_critters_array)) then set_array(exp_lh_wpn_drop_critters_array, len_array(exp_lh_wpn_drop_critters_array), target);
                  end
               end
               rnd = random(0, ((60 + target_pe * 4) * player_mult ));
               if rnd < (1 + Icrip)  then begin
                  critter_injure(target, DAM_BLIND);
               end
            end
         end
         attacker_curhp = get_critter_stat(attacker, STAT_current_hp);
         player_mult = 1;
         if attacker_in_party or attacker == dude_obj then begin
            player_mult = CripDiv;
         if combat_diff == 0 then player_mult = CripDiv * 3;
         end
      // criple for non robot attacker
         if player_mult > 0 andAlso weapon > 0 andAlso (not(attacker_in_party) or (attacker_in_party andAlso combat_diff > 0)) then begin
            attacker_type = metarule(METARULE_CRITTER_KILL_TYPE, attacker);
            if (wpn_dmg_type == DMG_explosion or wpnpid == 26) andAlso dmgtoatkr > (attacker_curhp / 6) andAlso wpnpid != 159 andAlso attacker_type != 10 then begin
               rnd = random(0, ((80) * player_mult ));
               if rnd < RLcrip then begin
                  critter_injure(attacker, DAM_CRIP_LEG_RIGHT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < LLcrip then begin
                  critter_injure(attacker, DAM_CRIP_LEG_LEFT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < RAcrip then begin
                  critter_injure(attacker, DAM_CRIP_ARM_RIGHT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < LAcrip then begin
                  critter_injure(attacker, DAM_CRIP_ARM_LEFT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < Icrip then begin
                  critter_injure(attacker, DAM_BLIND);
               end
            end
      // criple for robot attacker
            if ((dmgtoatkr > 5 andAlso wpn_dmg_type == DMG_emp) or (dmgtoatkr > (attacker_curhp / 3) andAlso (wpn_dmg_type == DMG_explosion))) andAlso attacker_type == 10 then begin
               rnd = random(0, ((80) * player_mult ));
               if rnd < RLcrip then begin
               critter_injure(attacker, DAM_CRIP_LEG_RIGHT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < LLcrip then begin
               critter_injure(attacker, DAM_CRIP_LEG_LEFT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < RAcrip then begin
               critter_injure(attacker, DAM_CRIP_ARM_RIGHT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < LAcrip then begin
               critter_injure(attacker, DAM_CRIP_ARM_LEFT);
               end
               rnd = random(0, ((80) * player_mult ));
               if rnd < (1 + Icrip) then begin
               critter_injure(attacker, DAM_BLIND);
               end
            end
         end
      end
   end

   cur_frm = art_anim(obj_art_fid(target));
   if DropProcActive <= 0 orElse (target_type == OBJ_TYPE_CRITTER andAlso cur_frm == 0 andAlso DropProcActive < 2) then begin
      if cur_frm == 0 andAlso target_type == OBJ_TYPE_CRITTER then begin
         gTimerTarget = target;
         call add_timed_wpn_drop when (art_anim(obj_art_fid(gTimerTarget)) != 0);
         if DropProcActive <= 0 then
            call add_timed_wpn_drop_ATTACK_END when _combat_turn_running <= 0;
         DropProcActive = 2;
      end
      else begin
         DropProcActive = 1;
         call add_timed_wpn_drop_ATTACK_END when _combat_turn_running <= 0;
      end
   end
end

procedure AFTERHITROLL begin
   DropProcActive = 0;
end

procedure get_config_set_float(variable ini_path, variable default_value) begin
   variable cur_value;
   cur_value = get_ini_string(ini_path);
   if (cur_value == "") then
      return default_value;
   else begin
      if cur_value == "0" orElse cur_value == "0.0" then
         return 0;
      else
         return atof(cur_value);
   end
end

procedure timed_event_p_proc begin
   variable timed_event = fixed_param;
   if timed_event == timed_wpn_drop then begin
      call setup_wpn_drop;
   end
   else if timed_event == timed_check_set_fid then begin
      call check_set_fid;
   end
   else if timed_event == timed_timed_wpn_drop_ATTACK_END then begin
      call setup_wpn_drop;
      call clear_lvars();
   end
end

procedure start begin
   if game_loaded then begin
      variable MissMod = get_ini_setting("mods\\F2MechanicsMiniRework.ini|MAIN|MissToHit");
      if MissMod > 0 then begin
         WpnDropCrit = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Miss|WeaponDropCriticalChance");
         WpnDropNonCrit = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Miss|WeaponDropNonCriticalChance");
         CrippleMod = get_ini_setting("mods\\F2MechanicsMiniRework.ini|MAIN|CripplingExplosions");
         DropAnyItem = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Miss|DropAnyItem");
         WeaponDropNonCriticalChanceNPCMultiplier = get_config_set_float(("mods\\F2MechanicsMiniRework.ini|Miss|WeaponDropNonCriticalChanceNPCMultiplier"), 2.0);
         WeaponDropCriticalChanceNPCMultiplier = get_config_set_float(("mods\\F2MechanicsMiniRework.ini|Miss|WeaponDropCriticalChanceNPCMultiplier"), 2.0);
         WeaponDropFinesseMultiplier = get_config_set_float(("mods\\F2MechanicsMiniRework.ini|Miss|WeaponDropFinesseMultiplier"), 2.0);
         //WeaponDropOneHanderDivMult = get_config_set_float(("mods\\F2MechanicsMiniRework.ini|Miss|WeaponDropOneHanderDivMult"), 1.5);
         WeaponDropOneHanderDivMult = 1.5;
         check_fid_arr = create_array_map;
         fix_array(check_fid_arr);
         if CrippleMod > 0 then begin
            RLcrip = get_ini_setting("mods\\F2MechanicsMiniRework.ini|CripplingExplosions|RLcrip");
            LLcrip = get_ini_setting("mods\\F2MechanicsMiniRework.ini|CripplingExplosions|LLcrip");
            RAcrip = get_ini_setting("mods\\F2MechanicsMiniRework.ini|CripplingExplosions|RAcrip");
            LAcrip = get_ini_setting("mods\\F2MechanicsMiniRework.ini|CripplingExplosions|LAcrip");
            Icrip = get_ini_setting("mods\\F2MechanicsMiniRework.ini|CripplingExplosions|ICrip");
            CripDiv = get_ini_setting("mods\\F2MechanicsMiniRework.ini|CripplingExplosions|CripDiv");
            exp_rh_wpn_drop_critters_array = create_array_map;
            fix_array(exp_rh_wpn_drop_critters_array);
            exp_lh_wpn_drop_critters_array = create_array_map;
            fix_array(exp_lh_wpn_drop_critters_array);
         end
         register_hook_proc_spec(HOOK_COMBATDAMAGE, COMBATDAMAGE);
         register_hook_proc_spec(HOOK_AFTERHITROLL, AFTERHITROLL);
         set_global_script_type(0);
         set_global_script_repeat(0);
      end
   end
end
