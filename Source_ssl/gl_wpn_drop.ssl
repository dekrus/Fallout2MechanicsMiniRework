procedure cancel_timed_check_set_fid begin
   variable was_set;
   variable fid;
   variable no_wpn_fid;

   if (gTimerTarget1 != 0) then begin
      fid = obj_art_fid(gTimerTarget1);
      no_wpn_fid = critter_art_fid(gTimerTarget1);
      if fid != no_wpn_fid then begin
         was_set = 1;
         set_object_data(gTimerTarget1, OBJ_DATA_FID, no_wpn_fid);
      end
      gTimerTarget1 = 0;
      cancel(add_timed_check_set_fid1);
   end

   if (gTimerTarget2 != 0) then begin
      fid = obj_art_fid(gTimerTarget2);
