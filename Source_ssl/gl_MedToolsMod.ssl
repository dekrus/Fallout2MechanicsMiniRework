//by Phobos2077 https://github.com/phobos2077/fo2_ecco/blob/f5df1e4edfe03c2df30fcf26f38ce8e2bdae4a4c/scripts_src/_pbs_main/gl_pbs_damage_mod.ssl#L515
procedure validate_critter_anim(variable critter, variable animType) begin
   variable objFid := obj_art_fid(critter);
   //variable rot := objFid bwand 0x70000000;
   // This is based on vanilla logic from art_id_()
   if (animType != ANIM_fire_dance and animType >= ANIM_fall_back and animType <= ANIM_fall_front_blood) then begin
      if (art_exists(critter_anim_fid(objFid, animType, 1))) then
         return true;
   end
   return art_exists(critter_anim_fid(objFid, animType, 0));
end

procedure find_min_charge_obj(variable inven_obj, variable charged_obj_pid, variable skip_hand_items = 0) begin
   variable inv_count = inven_count(inven_obj);
   variable inv_index;
   variable item;
   variable item_charge;
   variable last_min_charge;
   variable min_charge_obj = -1;
   variable left_hand_obj;
   variable right_hand_obj;

   if skip_hand_items > 0 then begin
      left_hand_obj = critter_inven_obj2(inven_obj, INVEN_TYPE_LEFT_HAND);
      right_hand_obj = critter_inven_obj2(inven_obj, INVEN_TYPE_RIGHT_HAND);
   end

   for (inv_index = 0; inv_index < inv_count; inv_index++) begin
      item = inven_ptr(inven_obj, inv_index);
      if skip_hand_items > 0 andAlso (item == right_hand_obj orElse item == left_hand_obj) then
         continue;

      // Check if item exists and matches charged object PID
      if item > 0 andAlso obj_pid(item) == charged_obj_pid then begin
         // Get current charges of the item
         item_charge = get_object_data(item, OBJ_DATA_CUR_CHARGES);
         // Update min_charge_obj if uninitialized or current item has fewer charges
         if min_charge_obj == -1 orElse item_charge < last_min_charge then begin
            last_min_charge = item_charge;
            min_charge_obj = item;
         end
      end
   end
   // Return min_charge_obj if found, otherwise return result of (obj_carrying_pid_obj(inven_obj, charged_obj_pid))
   if min_charge_obj > 0 then begin
      return min_charge_obj;
   end
   else begin
      min_charge_obj = obj_carrying_pid_obj(inven_obj, charged_obj_pid);
      if skip_hand_items > 0 andAlso min_charge_obj > 0 andAlso (min_charge_obj == right_hand_obj orElse min_charge_obj == left_hand_obj) then
         return 0;
      return min_charge_obj;
   end
end

procedure ui_disable begin
if set_ui_disable > 1 then
   return;

   game_ui_disable2;
   set_cursor_animated_watch;
   set_ui_disable = 2;
end

procedure ai_allow_continue_turn(variable critter) begin
   call_offset_v0(0x4227DC);//combat turn
   set_object_data(critter, OBJ_DATA_OUTLINE, get_object_data(critter, OBJ_DATA_OUTLINE) bwand OUTLINE_NOT_DISABLED);
   if set_ui_disable <= 0 then begin
      set_ui_disable = 1;
      call ui_disable when not(game_ui_is_disabled);
   end
end
procedure get_cheapest_attack_ap_cost(variable critter, variable target_distance) begin
   variable weapon;
   variable weapon_pid;
   variable ap_cost;
   variable ap_cost_2;
   variable weapon_range_1;
   variable weapon_range_2;
   variable attack1_available;
   variable attack2_available;

   weapon = critter_inven_obj2(critter, INVEN_TYPE_RIGHT_HAND);
   if weapon <= 0 then
      return 3 + target_distance;

   weapon_pid = obj_pid(weapon);
   ap_cost = get_proto_data(weapon_pid, PROTO_WP_APCOST_1);
   ap_cost_2 = get_proto_data(weapon_pid, PROTO_WP_APCOST_2);
   weapon_range_1 = get_proto_data(weapon_pid, PROTO_WP_RANGE_1);
   weapon_range_2 = get_proto_data(weapon_pid, PROTO_WP_RANGE_2);

   attack1_available = (target_distance <= weapon_range_1);
   attack2_available = (target_distance <= weapon_range_2);

   if attack1_available andAlso attack2_available then begin
      if ap_cost_2 < ap_cost then
         return ap_cost_2;
      return ap_cost;
   end

   if attack1_available then
      return ap_cost;

   if attack2_available then
      return ap_cost_2;

   if weapon_range_1 >= weapon_range_2 then begin
      return ap_cost + (target_distance - weapon_range_1);
   end
   else begin
      return ap_cost_2 + (target_distance - weapon_range_2);
   end
end

procedure g_use_item_self begin
   variable item;
   variable cur_ap;
   variable cur_hp;
   variable max_hp;
   variable enemy_target;
   variable enemy_distance;
   if gCritter == 0 orElse gItemPid == 0 then
      return;
   item = find_min_charge_obj(gCritter, gItemPid);
   cur_ap = get_critter_current_ap(gCritter);

   //item = 0;
   if item andAlso cur_ap >= gApCost then begin
      set_self(gCritter);
      set_self(gCritter);
      use_obj_on_obj(item, gCritter);
      set_self(0);
      set_critter_current_ap(gCritter, (cur_ap - gApCost));
      display_msg(parse_str_2(modmsg(msg_npc_use_item), obj_name(gCritter), proto_data(gItemPid, 1)));
      if gCritter != dude_obj then
         critter_set_flee_state(gCritter, 0);
   end
   else begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_stand, 0);
      reg_anim_animate_reverse(gCritter, ANIM_stand, 1);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
   if (gItemPid == PID_PARAMEDICS_BAG orElse gItemPid == doc_bag_pid) andAlso not(is_disabled(gCritter)) then begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
   else begin
      cur_hp = get_critter_stat(gCritter, STAT_current_hp);
      max_hp = get_critter_stat(gCritter, STAT_max_hp);
      cur_ap = get_critter_current_ap(gCritter);
      enemy_target = get_object_data(gCritter, OBJ_DATA_WHO_HIT_ME);
      if enemy_target then
         distance_objs(enemy_distance, gCritter, enemy_target);

      if cur_hp >= max_hp orElse (cur_hp > max_hp / random(2,3) andAlso cur_ap >= get_cheapest_attack_ap_cost(gCritter,enemy_distance) andAlso random(0,2)) then begin
         reg_anim_combat_check(0);
         reg_anim_clear_forced(gCritter, 1);
         reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
         reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);
         reg_anim_end();
         call ai_allow_continue_turn(gCritter);
      end
   end
end

procedure get_doc_repair_item_ap_cost(variable critter, variable skill, variable bonus) begin
   variable skill_value = (has_skill(critter, skill) + bonus);
   variable ap_cost = doc_item_ap_cost;
   if critter != dude_obj then
      skill_value += get_pc_stat(PCSTAT_level);

   if skill == SKILL_REPAIR then begin
      if critter_kill_type(critter) == KILL_TYPE_robot_kills then
         ap_cost = -3;
      else
         ap_cost -= 1;
   end

   if skill_value >= 50 then begin
      ap_cost = (ap_cost - (skill_value) / 50);
   end
   if ap_cost < min_doc_ap_cost then
      ap_cost = min_doc_ap_cost;

   return ap_cost;
end

procedure g_use_item_self_fa(variable critter, variable item) begin
   variable cur_ap;
   variable cur_hp;
   variable max_hp;
   variable enemy_target;
   variable enemy_distance;

   if critter == 0 orElse item == 0 then
      return;

   cur_ap = get_critter_current_ap(critter);
   cur_hp = get_critter_stat(critter, STAT_current_hp);
   max_hp = get_critter_stat(critter, STAT_max_hp);

   enemy_target = get_object_data(critter, OBJ_DATA_WHO_HIT_ME);
   if enemy_target then
      distance_objs(enemy_distance, critter, enemy_target);

   if (cur_ap >= get_cheapest_attack_ap_cost(critter, enemy_distance) andAlso cur_hp >= max_hp / 2) orElse cur_hp >= max_hp orElse cur_ap < fa_item_ap_cost then
      return;

   if cur_ap >= fa_item_ap_cost then begin
      set_self(critter);
      set_self(critter);
      use_obj_on_obj(item, critter);
      set_self(0);
      set_critter_current_ap(critter, (cur_ap - fa_item_ap_cost));
      display_msg(parse_str_2(modmsg(msg_npc_use_item), obj_name(critter), proto_data(obj_pid(item), 1)));
      if critter != dude_obj then
         critter_set_flee_state(critter, 0);
   end
   else begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(critter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(critter, ANIM_stand, 0);
      reg_anim_animate_reverse(critter, ANIM_stand, 1);
      reg_anim_end();
      call ai_allow_continue_turn(critter);
   end

   cur_hp = get_critter_stat(critter, STAT_current_hp);
   max_hp = get_critter_stat(critter, STAT_max_hp);
   if cur_hp >= max_hp then begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(critter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(critter, ANIM_magic_hands_middle, 0);
      reg_anim_end();
      call ai_allow_continue_turn(critter);
   end
end

procedure g_use_item_self_doc(variable critter, variable item) begin
   variable cur_ap;
   variable cur_hp;
   variable max_hp;
   variable ap_cost;

   if critter == 0 orElse item == 0 then
      return;

   if obj_pid(item) == PID_PARAMEDICS_BAG then
      ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_DOCTOR, paramedics_bag_bonus);
   else if obj_pid(item) == doc_bag_pid then
      ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_DOCTOR, doctors_bag_bonus);
   else
      ap_cost = min_doc_ap_cost;

   cur_ap = get_critter_current_ap(critter);
   cur_hp = get_critter_stat(critter, STAT_current_hp);
   max_hp = get_critter_stat(critter, STAT_max_hp);

   if cur_hp >= max_hp orElse cur_ap < ap_cost then
      return;

   // Используем предмет
   if cur_ap >= ap_cost then begin
      set_self(critter);
      set_self(critter);
      use_obj_on_obj(item, critter);
      set_self(0);
      set_critter_current_ap(critter, (cur_ap - ap_cost));
      display_msg(parse_str_2(modmsg(msg_npc_use_item), obj_name(critter), proto_data(obj_pid(item), 1)));
      if critter != dude_obj then
         critter_set_flee_state(critter, 0);
   end
   else begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(critter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(critter, ANIM_stand, 0);
      reg_anim_animate_reverse(critter, ANIM_stand, 1);
      reg_anim_end();
      call ai_allow_continue_turn(critter);
   end

   // Прерывание, если HP полное
   cur_hp = get_critter_stat(critter, STAT_current_hp);
   max_hp = get_critter_stat(critter, STAT_max_hp);
   if cur_hp >= max_hp then begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(critter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(critter, ANIM_magic_hands_middle, 0);
      reg_anim_end();
      call ai_allow_continue_turn(critter);
   end
end

procedure g_use_check_item_and_self_heal begin
   variable cur_hp;
   variable max_hp;
   variable doc_item;
   variable fa_item;

   if gCritter == 0 then
      return;


   //doc
   if is_disabled(gCritter) then begin

      doc_item = find_min_charge_obj(gCritter, PID_PARAMEDICS_BAG);
      if not(doc_item) then begin
         doc_item = find_min_charge_obj(gCritter, doc_bag_pid);
         if not(doc_item) andAlso StimUninjure > 0 then begin
            doc_item = obj_carrying_pid_obj(gCritter, PID_SUPER_STIMPAK);
         end
      end

      if doc_item then begin
         call g_use_item_self_doc(gCritter, doc_item);
         return;
      end

      cur_hp = get_critter_stat(gCritter, STAT_current_hp);
      max_hp = get_critter_stat(gCritter, STAT_max_hp);
      if cur_hp < max_hp - 10 then begin
         fa_item = find_min_charge_obj(gCritter, PID_FIELD_MEDIC_KIT);
         if not(fa_item) then begin
            fa_item = find_min_charge_obj(gCritter, PID_FIRST_AID_KIT);
            if not(fa_item) andAlso RegenMod <= 0 then
               fa_item = obj_carrying_pid_obj(gCritter, PID_STIMPAK);
         end

         if fa_item then begin
            call g_use_item_self_fa(gCritter, fa_item);
            return;
         end
      end
   end
   //fa
   else begin
      fa_item = find_min_charge_obj(gCritter, PID_FIELD_MEDIC_KIT);
      if fa_item <= 0 then begin
         fa_item = find_min_charge_obj(gCritter, PID_FIRST_AID_KIT);
         if not(fa_item) andAlso RegenMod <= 0 then
            fa_item = obj_carrying_pid_obj(gCritter, PID_STIMPAK);
      end

      if fa_item > 0 then begin
         call g_use_item_self_fa(gCritter, fa_item);
         return;
      end

      cur_hp = get_critter_stat(gCritter, STAT_current_hp);
      max_hp = get_critter_stat(gCritter, STAT_max_hp);

      if cur_hp < max_hp / 5 then begin
         doc_item = find_min_charge_obj(gCritter, doc_bag_pid);
         if not(doc_item) then begin
            doc_item = find_min_charge_obj(gCritter, PID_PARAMEDICS_BAG);
            if not(doc_item) then begin
               doc_item = obj_carrying_pid_obj(gCritter, PID_SUPER_STIMPAK);
            end
         end

         if doc_item then begin
            call g_use_item_self_doc(gCritter, doc_item);
            return;
         end
      end
   end

   return;
end

procedure g_use_item_self_fa_old begin
   variable item;
   variable cur_ap;
   variable cur_hp;
   variable max_hp;
   variable enemy_target;
   variable enemy_distance;
   if gCritter == 0 orElse gItemPid == 0 then
      return;
   cur_ap = get_critter_current_ap(gCritter);
   cur_hp = get_critter_stat(gCritter, STAT_current_hp);
   max_hp = get_critter_stat(gCritter, STAT_max_hp);
   enemy_target = get_object_data(gCritter, OBJ_DATA_WHO_HIT_ME);
   if enemy_target then
      distance_objs(enemy_distance, gCritter, enemy_target);

   if (cur_ap >= get_cheapest_attack_ap_cost(gCritter, enemy_distance) andAlso cur_hp >= max_hp / 2) orElse cur_hp >= max_hp orElse cur_ap < fa_item_ap_cost then
      return;

   item = find_min_charge_obj(gCritter, PID_FIELD_MEDIC_KIT);
   if item == 0 then
      item = find_min_charge_obj(gCritter, PID_FIRST_AID_KIT);

   if item andAlso cur_ap >= fa_item_ap_cost then begin
      set_self(gCritter);
      set_self(gCritter);
      use_obj_on_obj(item, gCritter);
      set_self(0);
      set_critter_current_ap(gCritter, (cur_ap - fa_item_ap_cost));
      display_msg(parse_str_2(modmsg(msg_npc_use_item), obj_name(gCritter), proto_data(gItemPid, 1)));
      if gCritter != dude_obj then
         critter_set_flee_state(gCritter, 0);
   end
   else begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_stand, 0);
      reg_anim_animate_reverse(gCritter, ANIM_stand, 1);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
   cur_hp = get_critter_stat(gCritter, STAT_current_hp);
   max_hp = get_critter_stat(gCritter, STAT_max_hp);
   if cur_hp >= max_hp then begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
end

procedure g_use_item_on_target begin
   variable item;
   variable cur_ap;
   variable cur_hp;
   variable max_hp;
   variable cur_enemy;
   if gCritter == 0 orElse gItemPid == 0 orElse gTarget == 0 then
      return;
   item = find_min_charge_obj(gCritter, gItemPid);
   cur_ap = get_critter_current_ap(gCritter);

   //item = 0;
   if item andAlso cur_ap >= gApCost then begin
      call_offset_v3(0x49C5FC, gCritter, gTarget, item);
      set_critter_current_ap(gCritter, (cur_ap - gApCost));
      display_msg(parse_str_2(modmsg(msg_npc_use_item), obj_name(gCritter), proto_data(gItemPid, 1)));
      if gTarget != dude_obj then
         critter_set_flee_state(gTarget, 0);
      cur_enemy = get_object_data(gCritter, OBJ_DATA_WHO_HIT_ME);
      if cur_enemy != 0 andAlso get_object_data(gTarget, OBJ_DATA_WHO_HIT_ME) == 0 then
         set_object_data(gTarget, OBJ_DATA_WHO_HIT_ME, cur_enemy);
      set_object_data(gTarget, OBJ_DATA_COMBAT_STATE, get_object_data(gTarget, OBJ_DATA_COMBAT_STATE) bwor 1);
   end
   else begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_stand, 0);
      reg_anim_animate_reverse(gCritter, ANIM_stand, 1);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
   if (gItemPid == PID_PARAMEDICS_BAG orElse gItemPid == doc_bag_pid) andAlso not(is_disabled(gTarget)) then begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
   else begin
      cur_hp = get_critter_stat(gTarget, STAT_current_hp);
      max_hp = get_critter_stat(gTarget, STAT_max_hp);
      if cur_hp >= max_hp then begin
         reg_anim_combat_check(0);
         reg_anim_clear_forced(gCritter, 1);
         reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
         reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);
         reg_anim_end();
         call ai_allow_continue_turn(gCritter);
      end
   end
end

//uninjure
procedure uninjure(variable user,variable target, variable item_pid, variable skill_bonus, variable is_repair = 0) begin
   variable user_DOC;
   variable tar_max_hp;
   variable user_luck = get_critter_stat(user,STAT_lu);
   variable jinxed = has_trait(TRAIT_TRAIT, user, TRAIT_jinxed);
   variable rnd;
   variable dmg;
   variable target_state = critter_state(target);
   variable healed_limbs;
   if is_repair then begin
      user_DOC = has_skill(user, SKILL_REPAIR) - 25;
   end
   else
      user_DOC = has_skill(user, SKILL_DOCTOR);


   if user_DOC <= 0 then user_DOC = 1;


   user_DOC = user_DOC + skill_bonus + user_luck / 2;

   if user != dude_obj then begin
      user_DOC += get_pc_stat(PCSTAT_level);
      if combat_is_initialized andAlso user_DOC < min_doc_cmbt then begin
         if is_repair then
            user_DOC = min_repair_cmbt;
         else
            user_DOC = min_doc_cmbt;
      end
   end

   if user_DOC > 95 + user_luck/2 then
      user_DOC = 95 + user_luck/2;
   else if user_DOC < 1 then
      user_DOC = 1;

   if target_state BWAND DAM_CRIP_ARM_RIGHT then begin
      if user_DOC < 100 then
         rnd = random(0, 100);
      if rnd <= user_DOC then begin
      critter_uninjure(target, DAM_CRIP_ARM_RIGHT);
      if user == dude_obj then
         display_msg(modmsg(msg_heal_dude + is_repair * repair_msg) + modmsg(msg_rhand + is_repair * repair_msg));
      healed_limbs += 1;
      end
   end
   if target_state BWAND DAM_CRIP_LEG_LEFT then begin
      if user_DOC < 100 then
         rnd = random(0, 100);
      if rnd <= user_DOC then begin
      critter_uninjure(target, DAM_CRIP_LEG_LEFT);
      if user == dude_obj then
         display_msg(modmsg(msg_heal_dude + is_repair * repair_msg) + modmsg(msg_lleg + is_repair * repair_msg));
      healed_limbs += 1;
      end
   end
   if target_state BWAND DAM_CRIP_ARM_LEFT then begin
      if user_DOC < 100 then
         rnd = random(0, 100);
      if rnd <= user_DOC then begin
      critter_uninjure(target, DAM_CRIP_ARM_LEFT);
      if user == dude_obj then
         display_msg(modmsg(msg_heal_dude + is_repair * repair_msg) + modmsg(msg_lhand + is_repair * repair_msg));
      healed_limbs += 1;
      end
   end
   if target_state BWAND DAM_CRIP_LEG_RIGHT then begin
      if user_DOC < 100 then
         rnd = random(0, 100);
      if rnd <= user_DOC then begin
      critter_uninjure(target, DAM_CRIP_LEG_RIGHT);
      if user == dude_obj then
         display_msg(modmsg(msg_heal_dude + is_repair * repair_msg) + modmsg(msg_rleg + is_repair * repair_msg));
      healed_limbs += 1;
      end
   end
   if target_state BWAND DAM_BLIND then begin
      if user_DOC < 100 then
         rnd = random(0, 100);
      if rnd <= user_DOC then begin
      critter_uninjure(target, DAM_BLIND);
      if user == dude_obj then
         display_msg(modmsg(msg_heal_dude + is_repair * repair_msg) + modmsg(msg_eyes + is_repair * repair_msg));
      healed_limbs += 1;
      end
   end

   if healed_limbs > 0 then begin
      if is_repair <= 0 andAlso user == dude_obj then begin
         give_exp_points(healed_limbs * 50);
         display_msg(parse_str_2(modmsg(msg_exp),healed_limbs * 50,0));
      end
      if critter_is_fleeing(target) andAlso not(Is_Injured(target)) then
         if target != dude_obj then critter_set_flee_state(target, 0);
   end
   else if user == dude_obj andAlso healed_limbs < 1 andAlso user_DOC < 100 then begin
      rnd = random(0, 100);
      if jinxed <= 0 then
         user_DOC += random(1, user_luck * 3);

      if rnd > user_DOC then begin
         tar_max_hp = get_critter_stat(target, STAT_max_hp);
         dmg = random(1, ceil(tar_max_hp / 20.0) + 6 * is_repair);

         //if target == dude_obj then
            //display_msg(parse_str_2(modmsg(msg_critical_miss_dude), obj_name(target), dmg));
         //else
            //display_msg(parse_str_2(modmsg(msg_critical_miss_tar), obj_name(target), dmg));
         display_msg(modmsg(msg_critical_miss_dude));
         critter_dmg(target, dmg, DMG_normal_dam bwor DMG_BYPASS_ARMOR);
         doc_self_dmg = 1;
      end
      else
         display_msg(modmsg(msg_fail + is_repair * repair_msg));
   end

   return healed_limbs;
end

procedure do_repair(variable user, variable target, variable skill_bonus) begin
   variable tar_cur_hp = get_critter_stat(target, STAT_current_hp);
   variable tar_max_hp = get_critter_stat(target, STAT_max_hp);
   variable tar_lost_hp = tar_max_hp - tar_cur_hp;
   variable user_repair = has_skill(user, SKILL_REPAIR);
   variable hp_healed;
   variable healed_limbs;

   if tar_cur_hp >= tar_max_hp andAlso not(is_disabled(target)) then
      return;

   if is_disabled(target) then begin
      doc_self_dmg = 0;
      healed_limbs = uninjure(user, target, 0, skill_bonus, true);
   end
   else
      healed_limbs = -1;

   if healed_limbs == -1 orElse healed_limbs > 0 then begin
      if doc_self_dmg <= 0 andAlso tar_cur_hp > 0 andAlso tar_cur_hp < tar_max_hp then begin
         if user_repair <= 0 then user_repair = 1;

         hp_healed = 5 + random(((skill_bonus / 10) + (user_repair / 10)), ((skill_bonus / 5) + (user_repair / 6))) + ceil(tar_max_hp / 1000.0 * user_repair);
         if has_trait(TRAIT_PERK, user, PERK_mr_fixit) > 0 then hp_healed = hp_healed + random(5, 15);
         if hp_healed > tar_lost_hp then hp_healed = tar_lost_hp;

         if hp_healed > 0 then begin
            critter_heal(target, hp_healed);
            if user == dude_obj then
               display_msg(parse_str_2(modmsg(repair_msg + msg_dude_heal), hp_healed, 0));
         end
      end
   end
   else if healed_limbs < 0 andAlso user == dude_obj then
      display_msg(modmsg(repair_msg + msg_heal_failed));
end


procedure g_repair_self begin
   variable cur_ap;
   variable cur_hp;
   variable max_hp;
   variable enemy_target;
   variable enemy_distance;
   if gCritter == 0 then
      return;
   cur_ap = get_critter_current_ap(gCritter);
   cur_hp = get_critter_stat(gCritter, STAT_current_hp);
   max_hp = get_critter_stat(gCritter, STAT_max_hp);
   enemy_target = get_object_data(gCritter, OBJ_DATA_WHO_HIT_ME);
   if enemy_target then
      distance_objs(enemy_distance, gCritter, enemy_target);

   if (cur_ap >= get_cheapest_attack_ap_cost(gCritter, enemy_distance) andAlso cur_hp >= max_hp / 2) orElse cur_hp >= max_hp orElse cur_ap < fa_item_ap_cost then
      return;

   if cur_ap >= fa_item_ap_cost then begin
      call do_repair(gCritter, gCritter, 30);
      set_critter_current_ap(gCritter, (cur_ap - fa_item_ap_cost));
      display_msg(parse_str_2(modmsg(msg_npc_repairs_self), obj_name(gCritter), 0));
      if gCritter != dude_obj then
         critter_set_flee_state(gCritter, 0);
   end
   else begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_stand, 0);
      reg_anim_animate_reverse(gCritter, ANIM_stand, 1);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
   cur_hp = get_critter_stat(gCritter, STAT_current_hp);
   max_hp = get_critter_stat(gCritter, STAT_max_hp);
   if cur_hp >= max_hp then begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
end

procedure find_nearest_free_tile(variable critter, variable dest_tile, variable multihex = 0) begin
   variable critter_tile = tile_num(critter);
   variable i;
   variable rotation_to_dest = rotation_to_tile(critter_tile, dest_tile);
   variable rot_to_check = ((rotation_to_dest + 2) % 6);
   variable tile_to_check;
   variable nearest_free_tile = -1;
   variable distance = tile_distance(critter_tile, dest_tile);
   variable last_path_len = 999;
   variable cur_path_len;
   variable cur_rotation = rot_to_check;
   variable check_dist = 1;
   if multihex > 0 then
      check_dist = 2;

   if (distance <= 1) then begin
      global_nearest_tile = critter_tile;
      global_path_len = 0;
      return critter_tile;
   end

   for (i := 0; i < 6; i++) begin
      cur_rotation = (cur_rotation + i) % 6;
      tile_to_check = tile_num_in_direction(dest_tile, cur_rotation, check_dist);

      if (tile_to_check == -1) then
         continue;

      cur_path_len = len_array(path_find_to(critter, tile_to_check, BLOCKING_TYPE_BLOCK));

      if (cur_path_len < 0) then
         continue;

      if (cur_path_len <= distance) then begin
         global_nearest_tile = tile_to_check;
         global_path_len = cur_path_len;
         return tile_to_check;
      end
      else if (cur_path_len < last_path_len) then begin
         nearest_free_tile = tile_to_check;
         last_path_len = cur_path_len;
      end
   end

   global_nearest_tile = nearest_free_tile;
   global_path_len = last_path_len;
   return nearest_free_tile;
end

procedure ai_search_wounded_friend(variable critter, variable ap_cost, variable heal_injury, variable is_repair = 0, variable skip_target = 0) begin
   variable cur_tile = tile_num(critter);
   variable critter_cur_ap = get_critter_current_ap(critter);
   variable critter_int;
   variable critter_pe;
   variable max_radius;
   variable radius;
   variable cur_elevation = elevation(critter);
   variable objects;
   variable count;
   variable state;
   variable target;
   variable target_tile;
   variable target_cur_hp;
   variable target_max_hp;
   variable target_state;
   variable critter_team = has_trait(TRAIT_OBJECT, critter, OBJECT_TEAM_NUM);
   variable target_hp_ratio;
   variable target_injuries;
   variable best_injuries = -1;
   variable best_choice = 0;
   variable target_effective_hp;
   variable dude_is_low;
   variable move_cost;
   variable best_move_cost = 9999;
   variable path_array;
   variable path_len;
   variable rnd;
   variable random_deviation;
   variable target_score;
   variable best_score = 999999;
   variable int_bonus;
   variable move_ap_budget;
   variable target_value;
   variable best_value = -9999;
   variable target_cur_anim;


   if critter_cur_ap <= ap_cost then
      return 0;

   move_ap_budget = critter_cur_ap - ap_cost;

   critter_int = get_critter_stat(critter, STAT_iq);
   if critter_int < 1 then critter_int = 1;
   if critter_int > 10 then critter_int = 10;

   random_deviation = 41 - critter_int * 4;
   if random_deviation < 5 then random_deviation = 5;
   if random_deviation > 40 then random_deviation = 40;

   int_bonus = (critter_int - 5) * 10;

   state = critter_state(critter);

   if (state bwand DAM_CRIP_LEG_LEFT) andAlso (state bwand DAM_CRIP_LEG_RIGHT) then begin
      radius = 1;
   end
   else if (state bwand DAM_CRIP_LEG_LEFT) orElse (state bwand DAM_CRIP_LEG_RIGHT) then begin
      radius = 2;
   end
   else begin
      radius = move_ap_budget;
   end

   critter_pe = get_critter_stat(critter, STAT_pe);
   max_radius = critter_pe * 5;

   if radius < 1 then
      radius = 1;
   else if radius > max_radius then
      radius = max_radius;

   objects = objects_in_radius(cur_tile, radius, cur_elevation, OBJ_TYPE_CRITTER);
   count = len_array(objects);

   if count <= 0 then
      return 0;

   foreach target in objects begin
      if target == critter orElse target == skip_target orElse not(obj_is_visible_flag(target)) then
         continue;

      if (critter_kill_type(target) == KILL_TYPE_robot_kills) != (is_repair > 0) then begin
         continue;
      end

      target_cur_hp = get_critter_stat(target, STAT_current_hp);
      target_max_hp = get_critter_stat(target, STAT_max_hit_points);
      target_state = critter_state(target);

      if (critter_team != has_trait(TRAIT_OBJECT, target, OBJECT_TEAM_NUM)) orElse (target_cur_hp >= target_max_hp andAlso (heal_injury <= 0 orElse not(is_disabled(target)))) orElse (is_really_dead(target, target_state, target_cur_hp)) then begin
         continue;
      end
      target_tile = tile_num(target);

      path_array = path_find_to(critter, find_nearest_free_tile(critter, target_tile, (get_flags(target) bwand FLAG_MULTIHEX)), BLOCKING_TYPE_BLOCK);
      path_len = len_array(path_array);

      if path_len <= 0 then begin
         continue;
      end

      move_cost = path_len - 1;
      if move_cost < 0 then move_cost = 0;

      if move_cost + ap_cost > critter_cur_ap then
         continue;

      target_hp_ratio = (target_cur_hp * 100) / target_max_hp;

      if target == dude_obj then begin
         if target_hp_ratio <= 7 then begin
            dude_is_low = 1;
            target_effective_hp = -9999;
         end
         else begin
            target_cur_anim = art_anim(obj_art_fid(target));
            if is_in_prone_anim(target_cur_anim) then
               target_effective_hp = target_hp_ratio - 15;
            else
               target_effective_hp = target_hp_ratio + 15;
         end
      end
      else begin
         target_effective_hp = target_hp_ratio;
      end

      target_injuries = 0;
      if heal_injury > 0 then begin
         if (target_state bwand DAM_CRIP_ARM_LEFT) then target_injuries += 1;
         if (target_state bwand DAM_CRIP_ARM_RIGHT) then target_injuries += 1;
         if (target_state bwand DAM_CRIP_LEG_LEFT) then target_injuries += 1;
         if (target_state bwand DAM_CRIP_LEG_RIGHT) then target_injuries += 1;
         if (target_state bwand DAM_BLIND) then target_injuries += 1;

         if target_injuries <= 0 andAlso (is_repair <= 0 andAlso target_hp_ratio > 25) then
            continue;
      end
      else if target_hp_ratio > 85 then
         continue;

      target_score = target_effective_hp + move_cost - int_bonus / 3;

      rnd = random(0, 100);
      if rnd < random_deviation then begin
         target_score += random(0, random_deviation);
      end

      if best_choice == 0 then begin
         best_choice = target;
         best_score = target_score;
         best_injuries = target_injuries;
         best_move_cost = move_cost;
         if heal_injury > 0 then
            best_value = best_injuries * 3 - best_move_cost;
      end
      else if target == dude_obj andAlso target_hp_ratio < 7 then begin
         best_choice = target;
         best_score = target_score;
         best_injuries = target_injuries;
         best_move_cost = move_cost;
         if heal_injury > 0 then
            best_value = best_injuries * 3 - best_move_cost;
      end
      //else if best_choice == dude_obj andAlso dude_is_low > 0 then begin

      //end
      else if heal_injury > 0 then begin
         target_value = target_injuries * 3 - move_cost;

         if target_value > best_value then begin
            if move_cost <= move_ap_budget then begin
               best_choice = target;
               best_score = target_score;
               best_injuries = target_injuries;
               best_move_cost = move_cost;
               best_value = target_value;
            end
         end
         else if target_value == best_value then begin
            if target_score < best_score then begin
               best_choice = target;
               best_score = target_score;
               best_injuries = target_injuries;
               best_move_cost = move_cost;
               best_value = target_value;
            end
         end
         else begin
            rnd = random(0, 100);
            if rnd < random_deviation / 2 then begin
               if move_cost <= move_ap_budget then begin
                  best_choice = target;
                  best_score = target_score;
                  best_injuries = target_injuries;
                  best_move_cost = move_cost;
                  best_value = target_value;
               end
            end
         end
      end
      else begin
         if target_score < best_score then begin
            best_choice = target;
            best_score = target_score;
            best_injuries = target_injuries;
            best_move_cost = move_cost;
         end
         else begin
            rnd = random(0, 100);
            if rnd < random_deviation / 2 then begin
               best_choice = target;
               best_score = target_score;
               best_injuries = target_injuries;
               best_move_cost = move_cost;
            end
         end
      end
   end

   return best_choice;
end

