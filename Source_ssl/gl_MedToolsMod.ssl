procedure g_pick_up_item begin
   variable item;
   variable item_sid;
   variable owner;
   if gCritter == 0 orElse gObj == 0 then
      return;

   if obj_type(gObj) == OBJ_TYPE_ITEM then begin
      item = gObj;
   end
   else if obj_type(gObj) == OBJ_TYPE_CRITTER then begin
      if gitemPid <= 0 then
         return;
      item = obj_carrying_pid_obj(gObj, gitemPid);
      owner = 1;
   end

   if item then begin
      if gItemPid <= 0 then
         gItemPid = obj_pid(item);

      item_sid = get_object_data(item, OBJ_DATA_SID);
      if item_sid > 0 then begin
         set_obj_script_objects(item_sid, gCritter, item);
         exec_obj_script_proc(item_sid, pickup_proc);
      end
      if owner then
         rm_mult_objs_from_inven(gObj, item, 1);

      add_obj_to_inven(gCritter, item);
   end
end

procedure reg_anim_combat_get_and_use_item_on_self(variable critter, variable obj, variable itemPid) begin
   variable i;
   //if count > 13 then
      //count = 13;
   gCritter = critter;
   gObj = obj;
   gItemPid = itemPid;

   reg_anim_combat_check(0);
   reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
   reg_anim_obj_run_to_obj(gCritter, obj, 0);
   reg_anim_turn_towards(gCritter, tile_num(obj), -1);
   if validate_critter_anim(gCritter, ANIM_magic_hands_ground) then
      reg_anim_animate(gCritter, ANIM_magic_hands_ground, -1);
   reg_anim_callback(g_pick_up_item);
   if validate_critter_anim(gCritter, ANIM_magic_hands_middle) then
      reg_anim_animate(gCritter, ANIM_magic_hands_middle, -1);
   reg_anim_callback(g_use_item_self);
   reg_anim_end();
   call ai_allow_continue_turn(gCritter);
end

procedure reg_anim_combat_use_item_on_target(variable critter, variable critter_cur_anim, variable target, variable itemPid, variable ap_cost, variable count, variable self_heal) begin
   variable i;
   variable animate;
   variable enemy_target;
   variable standup_anim;
   if count > 10 then
      count = 10;
   gCritter = critter;
   gTarget = target;
   gApCost = ap_cost;
   gItemPid = itemPid;


   animate = validate_critter_anim(gCritter, ANIM_magic_hands_middle);

   if critter_cur_anim == ANIM_fall_back orElse critter_cur_anim == ANIM_fall_back_sf then
      standup_anim = ANIM_back_to_standing;
   else if critter_cur_anim == ANIM_fall_front orElse critter_cur_anim == ANIM_fall_front_sf then
      standup_anim = ANIM_prone_to_standing;

   reg_anim_combat_check(0);
   reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
   if standup_anim != 0 then
      reg_anim_animate(gCritter, standup_anim, -1);
   reg_anim_obj_run_to_obj(gCritter, target, -1);
   reg_anim_turn_towards(gCritter, tile_num(target), -1);
   for (i := 0; i < count; i++) begin
   reg_anim_callback(g_use_item_on_target);
      if animate then
         reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);

      if count > 1 then begin
         reg_anim_animate(gCritter, ANIM_stand, -1);
         reg_anim_animate_reverse(gCritter, ANIM_stand, 0);
      end
   end
   if self_heal then begin
      reg_anim_callback(g_use_check_item_and_self_heal);
      enemy_target = get_object_data(gCritter, OBJ_DATA_WHO_HIT_ME);
      if enemy_target != 0 then
         reg_anim_turn_towards(gCritter, tile_num(enemy_target), -1);
      if animate then
         reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);
   end
   reg_anim_end();
   call ai_allow_continue_turn(gCritter);
end

