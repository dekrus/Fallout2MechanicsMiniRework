procedure ai_search_for_fa_item(variable critter, variable ap_cost) begin
   variable cur_tile = tile_num(critter);
   variable critter_cur_ap = get_critter_current_ap(critter);
   variable critter_pe;
   variable max_radius;
   variable radius = critter_cur_ap;
   variable cur_elevation = elevation(critter);
   variable objects;
   variable obj;
   variable object_type;
   variable count;
   variable item;
   variable best_choice;
   variable best_path_len = 9999;
   variable best_tile = -1;
   variable item_tile;
   variable nearest_tile;
   variable state;
   variable critter_obj;
   variable critter_obj_tile;

   objects = tile_get_objs(cur_tile, cur_elevation);
   foreach obj in objects begin
      object_type = obj_type(obj);
      //if object_type == OBJ_TYPE_ITEM then begin
         //if obj_pid(obj) == PID_FIELD_MEDIC_KIT then
            //return obj;
         //else if obj_pid(obj) == PID_FIRST_AID_KIT then
            //best_choice = obj;
      //end
      //else
         if obj != critter andAlso object_type == OBJ_TYPE_CRITTER then begin
         item = obj_carrying_pid_obj(obj, PID_FIELD_MEDIC_KIT);
         if item then begin
            gItemPid = PID_FIELD_MEDIC_KIT;
            return obj;
         end
         else begin
            item = obj_carrying_pid_obj(obj, PID_FIRST_AID_KIT);
            if item then begin
               gItemPid = PID_FIRST_AID_KIT;
               if obj_type(best_choice) != OBJ_TYPE_ITEM then
                  best_choice = obj;
            end
         end
      end
   end

   if best_choice != 0 then
      return best_choice;


   state = critter_state(critter);
   if (state bwand DAM_CRIP_LEG_LEFT) andAlso (state bwand DAM_CRIP_LEG_RIGHT) then
      radius /= 8;
   else if (state bwand DAM_CRIP_LEG_LEFT) orElse (state bwand DAM_CRIP_LEG_RIGHT) then
      radius /= 4;

   radius -= (3 + ap_cost);


   critter_pe = get_critter_stat(critter, STAT_pe);
   max_radius = critter_pe * 3;

   if radius < 1 then
      radius = 1;
   else if radius > max_radius then
      radius = max_radius;

   //objects = objects_in_radius(cur_tile, radius, cur_elevation, OBJ_TYPE_ITEM);
   //count = len_array(objects);
   //global_path_len = -1;
   //global_nearest_tile = -1;
//
   //if (count > 0) then begin
      //foreach item in objects begin
         //if (obj_pid(item) == PID_FIRST_AID_KIT orElse obj_pid(item) == PID_FIELD_MEDIC_KIT) then begin
            //item_tile = tile_num(item);
//
            //nearest_tile = find_nearest_free_tile(critter, item_tile);
//
            //if nearest_tile == cur_tile then begin
               //best_choice = item;
               //return best_choice;
            //end
//
//
            //if (nearest_tile != -1 andAlso global_path_len > 0 andAlso global_path_len < best_path_len) then begin
               //best_path_len = global_path_len;
               //best_choice = item;
               //best_tile = global_nearest_tile;
            //end
         //end
      //end
   //end

   objects = objects_in_radius(cur_tile, radius, cur_elevation, OBJ_TYPE_CRITTER);
   count = len_array(objects);
   global_path_len = -1;
   global_nearest_tile = -1;
   if (count <= 0) then
      return 0;

   foreach critter_obj in objects begin
      if not((get_object_data(critter_obj, OBJ_DATA_DAMAGE_FLAGS) bwand DAM_KNOCKED_OUT) == DAM_KNOCKED_OUT) andAlso not(is_really_dead(critter_obj, critter_state(critter_obj), get_critter_stat(critter_obj, STAT_current_hp))) then
         continue;

      item = obj_carrying_pid_obj(critter_obj, PID_FIELD_MEDIC_KIT);

      if item then begin
         item_tile = tile_num(critter_obj);

         nearest_tile = find_nearest_free_tile(critter, item_tile);

         if nearest_tile == cur_tile then begin
            best_choice = critter_obj;
            gItemPid = PID_FIELD_MEDIC_KIT;
            return best_choice;
         end


         if (nearest_tile != -1 andAlso global_path_len > 0 andAlso global_path_len < best_path_len) then begin
            best_path_len = global_path_len;
            best_choice = critter_obj;
            gItemPid = PID_FIELD_MEDIC_KIT;
            best_tile = global_nearest_tile;
         end
      end
      else begin
         item = obj_carrying_pid_obj(critter_obj, PID_FIRST_AID_KIT);
         if item then begin
            item_tile = tile_num(critter_obj);

            nearest_tile = find_nearest_free_tile(critter, item_tile);

            if nearest_tile == cur_tile then begin
               best_choice = critter_obj;
               gItemPid = PID_FIRST_AID_KIT;
               return critter_obj;
            end


            if (nearest_tile != -1 andAlso global_path_len > 0 andAlso global_path_len < best_path_len) then begin
               best_path_len = global_path_len;
               best_choice = critter_obj;
               gItemPid = PID_FIRST_AID_KIT;
               best_tile = global_nearest_tile;
            end
         end
      end
   end


   return best_choice;
end


procedure get_heal_friend_chance(variable critter, variable target, variable skill) begin
   variable critter_int = get_critter_stat(critter, STAT_iq);
   variable critter_skill;
   variable target_cur_hp = get_critter_stat(target, STAT_current_hp);
   variable target_max_hp = get_critter_stat(target, STAT_max_hit_points);
   variable target_hp_ratio = (target_cur_hp * 100) / target_max_hp;
   variable heal_chance = 0;

   if target_hp_ratio >= 60 then
      return 0;

   critter_skill = has_skill(critter, skill);
   if target_hp_ratio < 10 then
      return 101;

   heal_chance = (critter_int * 5) + (critter_skill / 6) + ((60 - target_hp_ratio) * 2);

   if heal_chance > 96 then
      heal_chance = 96;
   else if heal_chance < 7 then
      heal_chance = 7;

   return heal_chance;
end

