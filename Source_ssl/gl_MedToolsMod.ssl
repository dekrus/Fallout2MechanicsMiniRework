         if animate2 == 1 then begin
            reg_anim_callback(g_use_repair_on_target_punch);
            reg_anim_animate(gCritter, ANIM_throw_punch, -1);
            reg_anim_play_sfx(gCritter,sfx_build_char_name(gCritter,ANIM_throw_punch,snd_contact), 0);

            animate2 = 2;
         end
         else if count > 1 then begin
            reg_anim_callback(g_use_repair_on_target_revers);
            reg_anim_animate_reverse(gCritter, ANIM_throw_punch, -1);
            reg_anim_play_sfx(gCritter,sfx_build_char_name(gCritter,ANIM_throw_punch,snd_contact), 0);
            animate2 = 1;
         end
      end
   end
   reg_anim_end();
   call ai_allow_continue_turn(gCritter);
end


procedure reg_anim_combat_use_item_on_self(variable critter, variable critter_cur_anim, variable itemPid, variable ap_cost, variable count) begin
   variable i;
   variable animate;
   variable standup_anim;
   if count > 13 then
      count = 13;
   gCritter = critter;
   gItemPid = itemPid;
   gApCost = ap_cost;
   animate = validate_critter_anim(critter, ANIM_magic_hands_middle);

   if critter_cur_anim == ANIM_fall_back orElse critter_cur_anim == ANIM_fall_back_sf then
      standup_anim = ANIM_back_to_standing;
   else if critter_cur_anim == ANIM_fall_front orElse critter_cur_anim == ANIM_fall_front_sf then
      standup_anim = ANIM_prone_to_standing;

   reg_anim_combat_check(0);
   reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
   if standup_anim != 0 then
      reg_anim_animate(gCritter, standup_anim, -1);

   for (i := 0; i < count; i++) begin
      reg_anim_callback(g_use_item_self);
      if animate then
         reg_anim_animate(gCritter, ANIM_magic_hands_middle, 0);

      if count > 1 then begin
         reg_anim_animate(gCritter, ANIM_stand, -1);
         reg_anim_animate_reverse(gCritter, ANIM_stand, 0);
      end
   end
   reg_anim_end();
   call ai_allow_continue_turn(gCritter);
end

procedure med_item_charges_restore begin
   variable leftHand;
   variable rightHand;
   variable leftHand_pid;
   variable rightHand_pid;
   if MedToolsMod > 0 then begin
      leftHand = critter_inven_obj2(dude_obj, INVEN_TYPE_LEFT_HAND);
      rightHand = critter_inven_obj2(dude_obj, INVEN_TYPE_RIGHT_HAND);
      if leftHand then begin
         leftHand_pid = obj_pid(leftHand);
         if leftHand_pid == PID_FIRST_AID_KIT then begin
            if get_object_data(leftHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(leftHand, OBJ_DATA_CUR_CHARGES, random(min_charges,max_charges));
            end
         end
         else if leftHand_pid == PID_FIELD_MEDIC_KIT then begin
            if get_object_data(leftHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(leftHand, OBJ_DATA_CUR_CHARGES, random(min_charges_t2,max_charges_t2));
            end
         end
         else if leftHand_pid == doc_bag_pid then begin
            if get_object_data(leftHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(leftHand, OBJ_DATA_CUR_CHARGES, random(doc_min_charges,doc_max_charges));
            end
         end
         else if leftHand_pid == PID_PARAMEDICS_BAG then begin
            if get_object_data(leftHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(leftHand, OBJ_DATA_CUR_CHARGES, random(doc_min_charges_t2,doc_max_charges_t2));
            end
         end
      end
      if rightHand then begin
         rightHand_pid = obj_pid(rightHand);
         if rightHand_pid == PID_FIRST_AID_KIT then begin
            if get_object_data(rightHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(rightHand, OBJ_DATA_CUR_CHARGES, random(min_charges,max_charges));
            end
         end
         else if rightHand_pid == PID_FIELD_MEDIC_KIT then begin
            if get_object_data(rightHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(rightHand, OBJ_DATA_CUR_CHARGES, random(min_charges_t2,max_charges_t2));
            end
         end
         else if rightHand_pid == doc_bag_pid then begin
            if get_object_data(rightHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(rightHand, OBJ_DATA_CUR_CHARGES, random(doc_min_charges,doc_max_charges));
            end
         end
         else if rightHand_pid == PID_PARAMEDICS_BAG then begin
            if get_object_data(rightHand, OBJ_DATA_CUR_CHARGES) <= 0 then begin
               set_object_data(rightHand, OBJ_DATA_CUR_CHARGES, random(doc_min_charges_t2,doc_max_charges_t2));
            end
         end
      end
   end
end

//restores the number of uses of first aid kit
procedure GAMEMODECHANGE begin
   variable leftHand;
   variable rightHand;
   variable leftHand_pid;
   variable rightHand_pid;
   variable lastgamemode;
   variable game_mode;
   if MedToolsMod > 0 then begin
      game_mode = get_game_mode;
      lastgamemode = get_sfall_arg_at(1);
      if inven_use_ap_cost > 0 then begin
         if (game_mode bwand INVENTORY) andAlso not(lastgamemode bwand INVENTORY) then
            gInvenCurAP = get_critter_current_ap(dude_obj);
      end

      if heal_timer_needs_reset > 0 andAlso (lastgamemode bwand PIPBOY) andAlso not(game_mode bwand PIPBOY) then begin
         remove_timer_event(timed_event_heal_out_of_combat);
         add_global_timer_event(random(5,25), timed_event_heal_out_of_combat);
      end

      call med_item_charges_restore;
   end
end

procedure med_item_get_or_restore_charges(variable item) begin
   variable item_pid;
   variable cur_charges;
   variable new_charges;
   if item <= 0 then
      return;

   item_pid = obj_pid(item);
   if item_pid == PID_FIRST_AID_KIT then begin
      cur_charges = get_object_data(item, OBJ_DATA_CUR_CHARGES);
      new_charges = random(min_charges,max_charges);
   end
   else if item_pid == PID_FIELD_MEDIC_KIT then begin
      cur_charges = get_object_data(item, OBJ_DATA_CUR_CHARGES);
      new_charges = random(doc_min_charges_t2,doc_max_charges_t2);
   end
   else if item_pid == doc_bag_pid then begin
      cur_charges = get_object_data(item, OBJ_DATA_CUR_CHARGES);
      new_charges = random(doc_min_charges,doc_max_charges);
   end
   else if item_pid == PID_PARAMEDICS_BAG then begin
      cur_charges = get_object_data(item, OBJ_DATA_CUR_CHARGES);
      new_charges = random(doc_min_charges_t2,doc_max_charges_t2);
   end

   if new_charges > 0 andAlso (cur_charges <= 0 orElse cur_charges > new_charges)then begin
      set_object_data(item, OBJ_DATA_CUR_CHARGES, new_charges);
      cur_charges = new_charges;
   end
   return cur_charges;
end

//Changes AP cost of FA and DOC items
procedure CALCAPCOST begin
   variable critter = get_sfall_arg;
   variable item_pid;
   variable final_doc_ap_cost;
   variable active_item = get_active_weapon(critter);

   if active_item then
      item_pid = obj_pid(active_item);

   if item_pid == doc_bag_pid then begin
      final_doc_ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_DOCTOR, 20);
      set_sfall_return(final_doc_ap_cost);
      set_sfall_arg(3, final_doc_ap_cost);
   end
   else if item_pid == PID_PARAMEDICS_BAG then begin
      final_doc_ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_DOCTOR, 40);
      set_sfall_return(final_doc_ap_cost);
      set_sfall_arg(3, final_doc_ap_cost);
   end
   else if DisableRepairTools <= 0 andAlso item_pid == tool_pid then begin
      final_doc_ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_REPAIR, 20);
      set_sfall_return(final_doc_ap_cost);
      set_sfall_arg(3, final_doc_ap_cost);
   end
   else if DisableRepairTools <= 0 andAlso item_pid == super_tool_pid then begin
      final_doc_ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_REPAIR, 40);
      set_sfall_return(final_doc_ap_cost);
      set_sfall_arg(3, final_doc_ap_cost);
   end
end

inline procedure set_pid_flag_healing_item(variable item_pid) begin
   variable flag_ext;
   flag_ext = 0;
   if item_pid > 0 then begin
      flag_ext = get_proto_data(item_pid, PROTO_FLAG_EXT);
      if (flag_ext bwand HEALING_ITEM) == 0 then begin
         set_proto_data(item_pid, PROTO_FLAG_EXT, (flag_ext bwor HEALING_ITEM));
      end
   end
end

//add charges to FA and field medic kits
procedure map_enter_p_proc begin
   variable critter;
   variable party = party_member_list(0);
   variable critter_in_party;
   variable critter_cur_hp;
   variable critter_int;
   variable critter_type;
   variable doc_item;
   variable fa_item;
   variable rnd;
   variable doc_bag_count;
   variable paramedic_bag_count;
   variable fa_kit_count;
   variable fa_kit2_count;
   variable critter_pid;
   if MedToolsMod > 0 then begin
      if heal_timer_needs_reset > 0 then begin
         remove_timer_event(timed_event_heal_out_of_combat);
         add_global_timer_event(random(5,25), timed_event_heal_out_of_combat);
      end

      set_proto_data(PID_FIRST_AID_KIT, PROTO_MI_CHARGES, max_charges);
      set_proto_data(PID_FIELD_MEDIC_KIT, PROTO_MI_CHARGES, max_charges_t2);
      set_proto_data(doc_bag_pid, PROTO_MI_CHARGES, doc_max_charges);
      set_proto_data(PID_PARAMEDICS_BAG, PROTO_MI_CHARGES, doc_max_charges_t2);
      call set_pid_flag_healing_item(PID_FIRST_AID_KIT);
      call set_pid_flag_healing_item(PID_FIELD_MEDIC_KIT);
      call set_pid_flag_healing_item(doc_bag_pid);
      call set_pid_flag_healing_item(PID_PARAMEDICS_BAG);

      //add fa and doc item at first map loading
      if metarule(METARULE_TEST_FIRSTRUN,0) andAlso game_time > ONE_GAME_WEEK * 2 then begin
         foreach (critter in list_as_array(LIST_CRITTERS)) begin
               critter_in_party = is_in_array(critter, party);
               critter_cur_hp = get_critter_stat(critter, STAT_current_hp );
               critter_pid = obj_pid(critter);
               //critter_body_type = get_proto_data(critter_pid, PROTO_CR_BODY_TYPE);
               critter_type = critter_kill_type(critter);
            if obj_is_visible_flag(critter) andAlso not(is_dead(critter)) andAlso critter_cur_hp > 0 andAlso critter != dude_obj andAlso not(critter_in_party) andAlso can_use_items(critter_type) andAlso critter_type != KILL_TYPE_children_kills andAlso critter_type != KILL_TYPE_robot_kills then begin
               rnd = random(0, 100);
               doc_bag_count = obj_is_carrying_obj_pid(critter, doc_bag_pid);
               paramedic_bag_count = obj_is_carrying_obj_pid(critter, PID_PARAMEDICS_BAG);
               fa_kit_count = obj_is_carrying_obj_pid(critter, PID_FIRST_AID_KIT);
               fa_kit2_count = obj_is_carrying_obj_pid(critter, PID_FIELD_MEDIC_KIT);
               critter_int = get_critter_stat(critter, STAT_iq);
               if doc_bag_count <= 0 andAlso paramedic_bag_count <= 0 andAlso ( (is_medic(critter) andAlso rnd <= critter_int * 10) or (rnd <= 14 andAlso military_fid(critter)) or (is_brainy(critter) andAlso not(non_medic_fid(critter)) andAlso rnd < critter_int * 3) ) then begin
                  doc_item = create_object_sid(doc_bag_pid, 0, 0, -1);
                  if Sonora <= 0 andAlso (high_tec_fid(critter) andAlso rnd > 9) then begin
                     rm_obj_from_inven(critter, doc_item);
                     doc_item = create_object_sid(PID_PARAMEDICS_BAG, 0, 0, -1);
                     end
                  add_mult_objs_to_inven(critter, doc_item, 1);
               end
               rnd = random(0, 100);
               if Sonora <= 0 andAlso fa_kit_count <= 0 andAlso fa_kit2_count <= 0 andAlso ( (rnd == 0 andAlso critter_int > 4) or (is_medic(critter) andAlso rnd <= critter_int * 10) or (rnd <= 14 andAlso military_fid(critter)) or (is_brainy(critter) andAlso not(non_medic_fid(critter)) andAlso rnd < critter_int * 3) ) then begin
                  fa_item = create_object_sid(PID_FIRST_AID_KIT, 0, 0, -1);
                  if high_tec_fid(critter) andAlso rnd > 9 then rm_obj_from_inven(critter, fa_item);
                  if high_tec_fid(critter) andAlso rnd > 9 then fa_item = create_object_sid(PID_FIELD_MEDIC_KIT, 0, 0, -1);
                  add_mult_objs_to_inven(critter, fa_item, 1);
               end
            end
         end
      end
   end
end

procedure REMOVEINVENOBJ begin
   variable owner = get_sfall_arg;
   variable removed_item = get_sfall_arg;
   variable removed_item_pid = obj_pid(removed_item);
   variable item_charge;
   variable min_c;
   variable max_c;

   if removed_item_pid == PID_FIRST_AID_KIT then begin
      min_c = min_charges;
      max_c = max_charges;
   end
   else if removed_item_pid == PID_FIELD_MEDIC_KIT then begin
      min_c = min_charges_t2;
      max_c = max_charges_t2;
   end
   else if removed_item_pid == doc_bag_pid then begin
      min_c = doc_min_charges;
      max_c = doc_max_charges;
   end
   else if removed_item_pid == PID_PARAMEDICS_BAG then begin
      min_c = doc_min_charges_t2;
      max_c = doc_max_charges_t2;
   end
   else
      return;

   item_charge = get_object_data(removed_item, OBJ_DATA_CUR_CHARGES);
   if item_charge <= 0 then
      item_charge = max_c;
   else if item_charge > max_c then
      item_charge = max_c;
   else
      return;

   set_object_data(removed_item, OBJ_DATA_CUR_CHARGES, item_charge);
end


procedure get_ai_disposition(variable critter) begin
   variable disposition = call_offset_r1(0x428340, critter);
   return disposition;
end

procedure get_heal_uses_count(variable critter, variable heal_target, variable heal_ap_cost, variable skill_value, variable is_self_heal) begin
   variable critter_cur_ap;
   variable critter_int;
   variable attack_ap;
   variable heal_uses;
   variable max_heal_uses;
   variable base_heal_uses;
   variable target_cur_hp;
   variable target_max_hp;
   variable target_hp_ratio;
   variable int_skill_bonus;
   variable rnd;
   variable enemy_target;
   variable enemy_distance;
   variable enemy_in_range;
   variable max_attacks;
   variable ap_left;
   variable heal_possible;
   variable best_heal_uses;
   variable best_attacks;
   variable best_score;
   variable attacks_count;
   variable hp_weight;
   variable attacks_ap_used;
   variable heals_ap_used;
   variable total_ap_used;
   variable heal_ap_percent;
   variable score;
   variable diff;
   variable bonus_chance;
   variable penalty_chance;
   variable ap_penalty;
   variable aggression;
   variable hp_weight_modifier;
   variable heal_distance;
   variable move_ap_cost;
   variable state;
   variable min_attacks_desired;
   variable enemy_cur_hp;
   variable enemy_max_hp;
   variable enemy_hp_ratio;
   variable optimal_action_bonus;
   variable random_deviation;
   variable attacker_is_blind;

   aggression = get_object_ai_data(critter, AI_CAP_AGGRESSION);
   if aggression < 0 then aggression = 0;
   if aggression > 100 then aggression = 100;

   critter_int = get_critter_stat(critter, STAT_iq);
   if critter_int < 1 then critter_int = 1;
   if critter_int > 10 then critter_int = 10;

   optimal_action_bonus = (critter_int - 5) * 10;
   random_deviation = 41 - critter_int * 4;
   if random_deviation < 5 then random_deviation = 5;
   if random_deviation > 40 then random_deviation = 40;

   attacker_is_blind = Is_Blind(critter);

   hp_weight_modifier = -aggression / 2;

   if aggression >= 80 then
      min_attacks_desired = 1;
   else
      min_attacks_desired = 0;

   critter_cur_ap = get_critter_current_ap(critter);

   if is_self_heal then begin
      target_cur_hp = get_critter_stat(critter, STAT_current_hp);
      target_max_hp = get_critter_stat(critter, STAT_max_hp);
      move_ap_cost = 0;
      heal_distance = 0;
   end
   else begin
      if not heal_target then
         return 0;
      target_cur_hp = get_critter_stat(heal_target, STAT_current_hp);
      target_max_hp = get_critter_stat(heal_target, STAT_max_hit_points);

      if critter != heal_target then begin
         distance_objs(heal_distance, critter, heal_target);
         if heal_distance < 0 then heal_distance = 0;
      end
      else begin
         heal_distance = 0;
      end

      state = critter_state(critter);
      if (state bwand DAM_CRIP_LEG_LEFT) andAlso (state bwand DAM_CRIP_LEG_RIGHT) then
         move_ap_cost = heal_distance * 8;
      else if (state bwand DAM_CRIP_LEG_LEFT) orElse (state bwand DAM_CRIP_LEG_RIGHT) then
         move_ap_cost = heal_distance * 4;
      else
         move_ap_cost = heal_distance;
   end

   if critter_cur_ap <= move_ap_cost then
      return 0;

   if target_max_hp <= 0 then
      return 0;

   if heal_ap_cost <= 0 then
      heal_ap_cost = 1;

   target_hp_ratio = (target_cur_hp * 100) / target_max_hp;

   hp_weight = 100 - target_hp_ratio + hp_weight_modifier;

   if attacker_is_blind then
      hp_weight += 10;

   if hp_weight < 0 then hp_weight = 0;
   if hp_weight > 100 then hp_weight = 100;

   enemy_target = get_object_data(critter, OBJ_DATA_WHO_HIT_ME);
   enemy_in_range = 0;

   if not(enemy_target) andAlso critter != heal_target then begin
      enemy_target = get_object_data(heal_target, OBJ_DATA_WHO_HIT_ME);
      if enemy_target andAlso has_trait(TRAIT_OBJECT, enemy_target, OBJECT_TEAM_NUM) != has_trait(TRAIT_OBJECT, critter, OBJECT_TEAM_NUM) then
         set_object_data(critter, OBJ_DATA_WHO_HIT_ME, enemy_target);
      else
         enemy_target = 0;
   end

   if enemy_target andAlso not(is_really_dead(enemy_target, critter_state(enemy_target), get_critter_stat(enemy_target, STAT_current_hp))) then begin
      distance_objs(enemy_distance, critter, enemy_target);
      attack_ap = get_cheapest_attack_ap_cost(critter, enemy_distance);
      if attack_ap > 0 andAlso attack_ap <= (critter_cur_ap - move_ap_cost) then
         enemy_in_range = 1;

      enemy_cur_hp = get_critter_stat(enemy_target, STAT_current_hp);
      enemy_max_hp = get_critter_stat(enemy_target, STAT_max_hp);
      if enemy_max_hp > 0 then
         enemy_hp_ratio = (enemy_cur_hp * 100) / enemy_max_hp;
      else
         enemy_hp_ratio = 100;

   end
   else begin
      enemy_target = 0;
      enemy_in_range = 0;
      attack_ap = 999;
      enemy_cur_hp = 999;
      enemy_max_hp = 999;
      enemy_hp_ratio = 100;
   end

   max_heal_uses = (critter_cur_ap - move_ap_cost) / heal_ap_cost;
   int_skill_bonus = (critter_int * 5) + (skill_value / 10);

   if enemy_in_range then begin
      if attack_ap <= 0 then attack_ap = 1;
      max_attacks = (critter_cur_ap - move_ap_cost) / attack_ap;
      best_heal_uses = 0;
      best_attacks = 0;
      best_score = -1;

      for (attacks_count = max_attacks; attacks_count >= 0; attacks_count--) begin
         ap_left = critter_cur_ap - move_ap_cost - (attacks_count * attack_ap);
         if ap_left < 0 then
            continue;

         heal_possible = ap_left / heal_ap_cost;
         if heal_possible > max_heal_uses then
            heal_possible = max_heal_uses;

         ap_left = ap_left - (heal_possible * heal_ap_cost);

         attacks_ap_used = attacks_count * attack_ap;
         heals_ap_used = heal_possible * heal_ap_cost;
         total_ap_used = move_ap_cost + attacks_ap_used + heals_ap_used;

         if total_ap_used > 0 then begin
            if (attacks_ap_used + heals_ap_used) > 0 then
               heal_ap_percent = (heals_ap_used * 100) / (attacks_ap_used + heals_ap_used);
            else
               heal_ap_percent = 0;

            diff = heal_ap_percent - hp_weight;
            if diff < 0 then diff = -diff;

            ap_penalty = ap_left * 2;
            score = diff + ap_penalty;

            if ap_left == 0 then
               score -= 10;

            if attacker_is_blind andAlso attacks_count > 0 then begin
               if enemy_distance <= 1 then
                  score += attacks_count * 3;
               else
                  score += attacks_count * 10;

               if aggression >= 80 then
                  score -= attacks_count * 5;
            end

            if min_attacks_desired > 0 then begin
               if attacks_count < min_attacks_desired then
                  score += 100;
            end

            if (enemy_hp_ratio < 7 orElse enemy_cur_hp < 10) andAlso attacks_count > 0 then begin
               score -= 20;

               if critter_int >= 6 then
                  score -= 10;

               if attacker_is_blind then
                  score += 10;
            end

            if aggression >= 100 andAlso target_hp_ratio >= 25 then begin
               if heal_possible > 0 then
                  score += 50;
            end

            score -= optimal_action_bonus / 3;

            rnd = random(0, 100);
            if rnd < random_deviation then begin
               score += random(0, random_deviation);
            end

            if score < best_score orElse best_score == -1 then begin
               best_score = score;
               best_heal_uses = heal_possible;
               best_attacks = attacks_count;
            end
         end
      end

      base_heal_uses = best_heal_uses;
   end
   else begin
      base_heal_uses = max_heal_uses;
   end

   if target_hp_ratio < 15 then begin
      if attacker_is_blind then begin
         base_heal_uses = max_heal_uses;
      end
      else if critter_int <= 3 then begin
         if enemy_in_range andAlso (enemy_hp_ratio < 7 orElse enemy_cur_hp < 10) then begin

            rnd = random(0, 100);
            if rnd < 40 then begin
               base_heal_uses = 0;
            end
            else begin
               base_heal_uses = max_heal_uses;
            end
         end
         else begin
            base_heal_uses = random(max_heal_uses / 2, max_heal_uses);
         end
      end
      else begin
         base_heal_uses = max_heal_uses;
      end

      if base_heal_uses < 1 then
         base_heal_uses = 1;
   end
   else if target_hp_ratio >= 85 then begin
      if enemy_in_range then begin
         max_attacks = (critter_cur_ap - move_ap_cost) / attack_ap;
         ap_left = critter_cur_ap - move_ap_cost - (max_attacks * attack_ap);
         base_heal_uses = ap_left / heal_ap_cost;

         rnd = random(0, 100);

         if attacker_is_blind then begin
            if rnd < 50 then
               base_heal_uses = max_heal_uses / 2;
            else
               base_heal_uses = 0;
         end
         else if critter_int >= 6 then begin
            if rnd >= (10 - aggression / 10) then
               base_heal_uses = 0;
         end
         else if critter_int <= 3 then begin
            if rnd < 30 then
               base_heal_uses = max_heal_uses / 2;
            else if rnd >= (15 - aggression / 10) then
               base_heal_uses = 0;
         end
         else begin
            if rnd >= (15 - aggression / 10) then
               base_heal_uses = 0;
         end
      end
      else begin
         rnd = random(0, 100);
         if rnd < (15 - aggression / 10) then
            base_heal_uses = max_heal_uses;
         else
            base_heal_uses = 0;
      end
   end

   if base_heal_uses <= 0 then
      return 0;

   if base_heal_uses > max_heal_uses then
      base_heal_uses = max_heal_uses;

   rnd = random(0, 100);


   if rnd < random_deviation / 2 then begin
      if base_heal_uses < max_heal_uses then
         base_heal_uses += 1;
   end
   else if rnd < random_deviation then begin
      if base_heal_uses > 0 then
         base_heal_uses -= 1;
   end

   if base_heal_uses > 0 andAlso max_heal_uses > base_heal_uses then begin
      rnd = random(0, 100);
      if rnd < (10 + int_skill_bonus / 3) then
         base_heal_uses += 1;
   end

   bonus_chance = hp_weight;
   penalty_chance = 100 - hp_weight;

   rnd = random(0, 100);

   if rnd < bonus_chance / 2 then begin
      heal_uses = base_heal_uses + 1;
      if heal_uses > max_heal_uses then
         heal_uses = max_heal_uses;
   end
   else if rnd < bonus_chance then begin
      heal_uses = base_heal_uses;
   end
   else if rnd < bonus_chance + penalty_chance / 2 then begin
      heal_uses = base_heal_uses - 1;
      if heal_uses < 0 then
         heal_uses = 0;
   end
   else begin
      heal_uses = base_heal_uses;
   end

   if heal_uses > 1 then
      return random(heal_uses / 2, heal_uses);
   else
      return heal_uses;
end

procedure COMBATTURN begin
   variable turn_status = get_sfall_arg;
   variable critter = get_sfall_arg;
   variable critter_int;
   variable critter_type;
   variable critter_cur_hp;
   variable critter_max_hp;
   variable party;
   variable critter_in_party;
   variable rnd;
   variable critter_cur_state;
   variable ap_cost;
   variable critter_skill_doc;
   variable critter_skill_fa;
   variable critter_skill_repair;
   variable doc_item;
   variable fa_item;
   variable repair_item;
   variable heal_target;
   variable skill;
   variable doc_pid;
   variable doc_bonus;
   variable repair_bonus;
   variable fa_bonus;
   variable critter_cur_ap = get_critter_current_ap(critter);
   variable critter_cur_ap_on_turn_start = critter_cur_ap;
   variable stand_up;
   variable stand_up_cost;
   variable critter_cur_anim;
   variable critter_combat_flags;
   variable critter_is_robot;
   variable critter_is_repair_bot;
   variable critter_is_robobrain;
   variable critter_fid;
   combat_med_tool_used = 0;
   gCritter = 0;
   gItemPid = 0;
   gObj = 0;
   gTarget = 0;
   gApCost = 0;

   if critter == dude_obj orElse turn_status < 0 then begin
      if set_ui_disable == 1 then
         cancel (ui_disable);
      set_ui_disable = 0;
      return;
   end

   if turn_status != 1 orElse combat_direct_controll == 1 orElse tail_used > 0 orElse critter_cur_ap < fa_item_ap_cost then
      return;

   critter_type = critter_kill_type(critter);
   if critter_type == KILL_TYPE_robot_kills orElse get_proto_data(obj_pid(critter), PROTO_CR_BODY_TYPE) == CR_BODY_ROBOTIC then begin
      critter_fid = critter_art_fid(critter);
      if critter_fid == FID_MAHAND then
         critter_is_repair_bot = 1;
      else if critter_fid == FID_MAROBO then
         critter_is_robobrain = 1;
      critter_is_robot = 1;
   end

   critter_int = get_critter_stat(critter, STAT_iq);
   critter_skill_doc = has_skill(critter, SKILL_DOCTOR);
   critter_skill_fa = has_skill(critter, SKILL_FIRST_AID);
   critter_skill_repair = has_skill(critter, SKILL_REPAIR);

   if (critter_int <= 1 + ((critter_type == KILL_TYPE_children_kills) * 3) andAlso (critter_is_robot <= 0 andAlso critter_skill_doc + critter_skill_fa < 100)) orElse (not(can_use_items(critter_type)) andAlso (critter_is_robobrain + critter_is_repair_bot) <= 0) then
      return;

   party = party_member_list(0);
   critter_in_party = is_in_array(critter, party);
   if not((NPCsUseMedTools > 0 andAlso not(critter_in_party)) orElse (NPCsUseMedTools >= 2 andAlso combat_direct_controll != 2 andAlso critter_in_party)) then
      return;

   critter_cur_hp = get_critter_stat(critter, STAT_current_hp);
   critter_cur_state = critter_state(critter);

   if is_really_dead(critter, critter_cur_state, critter_cur_hp) orElse (get_object_data(dude_obj, OBJ_DATA_WHO_HIT_ME) == 0 andAlso get_object_data(critter, OBJ_DATA_WHO_HIT_ME) == 0  andAlso critter_cur_hp > 10)  then
      return;

   critter_cur_anim = art_anim(obj_art_fid(critter));
   critter_combat_flags = get_object_data(critter, OBJ_DATA_DAMAGE_FLAGS);
   if is_in_prone_anim(critter_cur_anim) then begin
      stand_up = 1;
      if critter_in_party andAlso has_trait(TRAIT_PERK, critter, PERK_quick_recovery_perk) then
         stand_up_cost = 1;
      else
         stand_up_cost = 3;

      critter_cur_ap -= stand_up_cost;
      if critter_cur_ap <= 0 then
         critter_cur_ap = 0;

      if critter_combat_flags bwand DAM_KNOCKED_DOWN != 0 then
         set_object_data(critter, OBJ_DATA_DAMAGE_FLAGS, critter_combat_flags bwand bwnot(DAM_KNOCKED_DOWN));

      set_critter_current_ap(critter, critter_cur_ap);
   end

   critter_max_hp = get_critter_stat(critter, STAT_max_hp);

   if critter_is_robot <= 0 then begin
      doc_item = find_min_charge_obj(critter, PID_PARAMEDICS_BAG);
      if not(doc_item) then begin
         doc_item = find_min_charge_obj(critter, doc_bag_pid);
         if not(doc_item) then begin
            if StimUninjure > 0 then
               doc_item = obj_carrying_pid_obj(critter, PID_SUPER_STIMPAK);
         end
         else
            doc_bonus = 20;
      end
      else
         doc_bonus = 40;

      fa_item = find_min_charge_obj(critter, PID_FIELD_MEDIC_KIT);
      if not(fa_item) then begin
         fa_item = find_min_charge_obj(critter, PID_FIRST_AID_KIT);
         if fa_item then
            fa_bonus = 20;
      end
      else
         fa_bonus = 40;

      if critter_skill_repair >= 30 orElse not(critter_in_party) then begin
         repair_item = obj_carrying_pid_obj(critter, super_tool_pid);
         if not(repair_item) then begin
            repair_item = obj_carrying_pid_obj(critter, super_tool_pid);
            if repair_item then
               repair_bonus = 20;
         end
         else
            repair_bonus = 40;
      end
   end
   //robots
   else if critter_is_repair_bot andAlso combat_med_tool_used <= 0 andAlso (((critter_cur_state bwand DAM_CRIP_ARM_LEFT) == 0) orElse ((critter_cur_state bwand DAM_CRIP_ARM_RIGHT) == 0)) then begin
      skill = SKILL_REPAIR;
      ap_cost = get_doc_repair_item_ap_cost(critter, skill, 0);

      heal_target = ai_search_wounded_friend(critter, ap_cost, true, true);
      if heal_target andAlso (is_disabled(heal_target) orElse (get_critter_stat(heal_target, STAT_current_hp) <= 3 * get_critter_stat(heal_target, STAT_max_hp) / 4)) andAlso (random(0, 100) < critter_skill_repair) then begin
         combat_med_tool_used += 1;
         call reg_anim_combat_robot_repair_target(critter, critter_cur_anim, heal_target, ap_cost, random(1, 2), false);
      end
   end


   if combat_med_tool_used <= 0 andAlso doc_item andAlso (is_disabled(critter) orElse (critter_cur_hp < (critter_max_hp / 6))) andAlso (critter_type != KILL_TYPE_children_kills orElse (critter_int >= 9 andAlso critter_type == KILL_TYPE_children_kills)) andAlso critter_is_robot <= 0 then begin
      rnd = random(0, 100);
      if rnd < doc_bonus + 10 + critter_int * 10 then begin
         doc_pid = obj_pid(doc_item);
         if doc_pid == PID_PARAMEDICS_BAG then
            ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_DOCTOR, paramedics_bag_bonus);
         else
            ap_cost = get_doc_repair_item_ap_cost(critter, SKILL_DOCTOR, doctors_bag_bonus);

         if critter_cur_ap >= ap_cost then begin
            combat_med_tool_used += 1;
            call reg_anim_combat_use_item_on_self(critter, critter_cur_anim, doc_pid, ap_cost, 3);
         end
      end
   end

   if combat_med_tool_used <= 0 andAlso fa_item andAlso ((critter_max_hp <= 399 andAlso (critter_cur_hp < (critter_max_hp - 4 - (critter_max_hp / 10)))) orElse (critter_max_hp > 399 andAlso critter_cur_hp < critter_max_hp / 2)) andAlso can_use_items(critter_type) andAlso critter_is_robot <= 0 then begin
      rnd = random(0, 100);
      ap_cost = fa_item_ap_cost;

      if rnd < fa_bonus + 6 + ((5 * critter_int * critter_max_hp) / critter_cur_hp) then begin
         combat_med_tool_used = 1;
         call reg_anim_combat_use_item_on_self(critter, critter_cur_anim, obj_pid(fa_item), ap_cost, get_heal_uses_count(critter,critter,fa_item_ap_cost,critter_skill_fa,1));
      end
   end

   //frienldy heal
   if doc_item andAlso combat_med_tool_used <= 0 andAlso (critter_skill_doc >= 50 orElse random(0,3)) then begin
      skill = SKILL_DOCTOR;
      if obj_pid(doc_item) == PID_PARAMEDICS_BAG then
         ap_cost = get_doc_repair_item_ap_cost(critter, skill, paramedics_bag_bonus);
      else
         ap_cost = get_doc_repair_item_ap_cost(critter, skill, doctors_bag_bonus);

      heal_target = ai_search_wounded_friend(critter, ap_cost, true);


      if heal_target andAlso (is_disabled(heal_target) orElse (not(fa_item) andAlso get_critter_stat(heal_target, STAT_current_hp) <= 15)) andAlso (random(0, 100) < 20 + doc_bonus + critter_skill_doc) then begin
         combat_med_tool_used += 1;
         call reg_anim_combat_use_item_on_target(critter, critter_cur_anim, heal_target, obj_pid(doc_item), ap_cost, random(1, 2), random(0, 1));
      end
   end

   if fa_item andAlso combat_med_tool_used <= 0 andAlso (critter_skill_fa >= 50 orElse random(0,3)) then begin
      skill = SKILL_FIRST_AID;
      ap_cost = fa_item_ap_cost;
      heal_target = ai_search_wounded_friend(critter, ap_cost, 0);

      if heal_target andAlso (random(0, 100) < get_heal_friend_chance(critter, heal_target, skill)) then begin
         combat_med_tool_used += 1;
         call reg_anim_combat_use_item_on_target(critter, critter_cur_anim, heal_target, obj_pid(fa_item), ap_cost, get_heal_uses_count(critter,heal_target,ap_cost,critter_skill_fa,false), random(0, 1));
      end
   end

   //frienldy heal robot
   if repair_item andAlso combat_med_tool_used <= 0 andAlso (critter_skill_repair >= 50 orElse random(0,1)) then begin
      skill = SKILL_REPAIR;
      if obj_pid(repair_item) == super_tool_pid then
         ap_cost = get_doc_repair_item_ap_cost(critter, skill, super_tool_bonus);
      else
         ap_cost = get_doc_repair_item_ap_cost(critter, skill, tool_bonus);

      heal_target = ai_search_wounded_friend(critter, ap_cost, true, true);


      if heal_target andAlso (is_disabled(heal_target) orElse (get_critter_stat(heal_target, STAT_current_hp) <= 3 * get_critter_stat(heal_target, STAT_max_hp) / 4)) andAlso (random(0, 100) < critter_skill_repair) then begin
         combat_med_tool_used += 1;
         call reg_anim_combat_use_item_on_target(critter, critter_cur_anim, heal_target, obj_pid(repair_item), ap_cost, random(1, 2), false);
      end
   end

   if stand_up andAlso combat_med_tool_used <= 0 then begin
      set_object_data(critter, OBJ_DATA_DAMAGE_FLAGS, critter_combat_flags);
      set_critter_current_ap(critter, critter_cur_ap_on_turn_start);
   end
end

procedure med_tool_split_and_set_charge(variable user, variable med_tool_obj, variable new_charges) begin
   if med_tool_obj <= 0 then
      return;
   // Create a new medical tool object with the same PID
   med_tool_obj = create_object(obj_pid(med_tool_obj), 0, 0);
   // Set the new charges for the medical tool
   set_object_data(med_tool_obj, OBJ_DATA_CUR_CHARGES, new_charges);
   // Add the modified medical tool to the user's inventory
   add_obj_to_inven(user, med_tool_obj);
end

procedure set_inven_cur_ap begin
   gInvenCurAP = get_critter_current_ap(dude_obj);
end

procedure USEOBJ begin
   if combat_is_initialized then
      gInvenCurAP = get_critter_current_ap(dude_obj);
end

procedure INVENTORYMOVE begin
   if combat_is_initialized then
      gInvenCurAP = get_critter_current_ap(dude_obj);
end

procedure USEOBJON begin
   variable target = get_sfall_arg;
   variable user = get_sfall_arg;
   variable obj = get_sfall_arg;
   variable objpid = obj_pid(obj);
   variable objname;
   variable tar_name;
   variable user_FA;
   variable user_DOC;
   variable user_repair;
   variable tar_max_hp;
   variable tar_cur_hp;
   variable leftHand;
   variable rightHand;
   variable tar_lost_hp;
   variable skill_bonus;
   variable obj_charges;
   variable new_obj_charges;
   variable hp_healed;
   variable heal_cost;
   variable min_heal_chance;
   variable max_heal_chance;
   variable healer_perk;
   variable rnd;
   variable player_level;
   variable ap;
   variable cost;
   variable min_cost;
   variable qp_discount;
   variable target_type;
   variable another_item;
   variable game_mod;
   variable healed_limbs;
   cost = inven_use_ap_cost;

   if objpid != PID_FIRST_AID_KIT andAlso
      objpid != PID_FIELD_MEDIC_KIT andAlso
      objpid != doc_bag_pid andAlso
      objpid != PID_PARAMEDICS_BAG andAlso objpid != tool_pid andAlso objpid != super_tool_pid then
         return;

   if DisableRepairTools > 0 andAlso (objpid == tool_pid orElse objpid == super_tool_pid) then
      return;

   if obj_type(target) != OBJ_TYPE_CRITTER then begin
      if objpid != tool_pid andAlso objpid != super_tool_pid then begin
         display_msg(modmsg(msg_useless_act));
         set_sfall_return(0);
      end
      return false;
   end

   //check ap inven cost in combat
   game_mod = get_game_mode;
   if cost > 0 andAlso user == dude_obj andAlso combat_is_initialized then begin
      if (game_mod bwand INVENTORY) then begin
         call set_inven_cur_ap in 0;

         ap = gInvenCurAP;
         min_cost = inven_use_ap_cost_min;
         qp_discount = has_trait(TRAIT_PERK, user, PERK_quick_pockets) * inven_use_ap_cost_quick_pockets_discount;
         cost -= qp_discount;
         if cost < min_cost then
            cost = min_cost;
         if (ap < cost) then begin
            set_sfall_return(0);
            return;
         end
      end
   end

   target_type = critter_kill_type(target);
   objname = obj_name(obj);
   tar_name = obj_name(target);
   user_FA = has_skill(user, SKILL_FIRST_AID);
   user_DOC = has_skill(user, SKILL_DOCTOR);
   tar_max_hp = get_critter_stat(target, STAT_max_hp);
   tar_cur_hp = get_critter_stat(target, STAT_current_hp);
   leftHand = critter_inven_obj2(user, INVEN_TYPE_LEFT_HAND);
   rightHand = critter_inven_obj2(user, INVEN_TYPE_RIGHT_HAND);
   tar_lost_hp = tar_max_hp - tar_cur_hp;
   skill_bonus = first_aid_kit_bonus;
   heal_cost = 1;
   healer_perk = has_trait(TRAIT_PERK, user, PERK_healer);
   player_level = get_pc_stat(PCSTAT_level);
   obj_charges = get_object_data(obj, OBJ_DATA_CUR_CHARGES);

   //REPAIR
   if target_type == KILL_TYPE_robot_kills andAlso (objpid == tool_pid orElse objpid == super_tool_pid) then begin
      if objpid == tool_pid then
         skill_bonus = tool_bonus;
      else
         skill_bonus = super_tool_bonus;

      user_repair = has_skill(user, SKILL_REPAIR);
      if is_really_dead(target, critter_state(target), tar_cur_hp) then
         return;

      if user == dude_obj andAlso user_repair <= 0 then begin
         display_msg(parse_str_2(modmsg(msg_skill_needed), objname, 0));
         set_sfall_return(0);
         return;
      end
      else if user != dude_obj then
         user_repair += player_level;

      if user == dude_obj andAlso (game_mod bwand INVENTORY) andAlso combat_is_initialized then begin
         display_msg(modmsg(msg_use_from_hands));
         set_sfall_return(0);
         return;
      end
      if user == dude_obj andAlso leftHand != obj andAlso rightHand != obj andAlso combat_is_initialized then begin
         display_msg(modmsg(msg_use_from_hands));
         set_sfall_return(0);
         return;
      end
      if tar_cur_hp >= tar_max_hp andAlso not(is_disabled(target)) then begin
         //if user == dude_obj then begin
            //if target == dude_obj then
               //display_msg(modmsg(msg_dude_fullhp));
            //else
               //display_msg(parse_str_2(modmsg(msg_npc_fullhp), tar_name, 0));
         //end
         //set_sfall_return(0);
         return;
      end

      if is_disabled(target) then begin
         doc_self_dmg = 0;
         healed_limbs = uninjure(user, target, objpid, skill_bonus, true);
      end
      else
         healed_limbs = -1;

      if healed_limbs == -1 orElse healed_limbs > 0 then begin
         if doc_self_dmg <= 0 andAlso tar_cur_hp > 0 andAlso tar_cur_hp < tar_max_hp then begin
            if user_repair <= 0 then user_repair = 1;

            hp_healed = 5 + random(((skill_bonus / 10) + (user_repair / 10)), ((skill_bonus / 5) + (user_repair / 6))) + ceil(tar_max_hp / 1000.0 * user_repair);
            if has_trait(TRAIT_PERK, user, PERK_mr_fixit) > 0 then hp_healed = hp_healed + random(5, 15);
            if hp_healed > tar_lost_hp then hp_healed = tar_lost_hp;

            if hp_healed > 0 then begin
               critter_heal(target, hp_healed);
               if user == dude_obj then
                  display_msg(parse_str_2(modmsg(repair_msg + msg_dude_heal), hp_healed, 0));
            end
         end
         intface_redraw;
      end
      else if healed_limbs < 0 andAlso user == dude_obj then
         display_msg(modmsg(repair_msg + msg_heal_failed));

      set_sfall_return(0);
      return;
   end
   else if (objpid == tool_pid orElse objpid == super_tool_pid) then begin
      return;
   end
   else if target_type == KILL_TYPE_robot_kills then begin
      display_msg(modmsg(msg_useless_act));
      set_sfall_return(0);
      return;
   end

   if is_really_dead(target, critter_state(target), tar_cur_hp) then begin
      display_msg(modmsg(msg_target_is_dead));
      set_sfall_return(0);
      return;
   end


   if ET_TU == 0 then
      healer_perk = healer_perk * 2;
   //DOC
   if (objpid == doc_bag_pid orElse objpid == PID_PARAMEDICS_BAG) then begin
   //item charges restore
      if objpid == doc_bag_pid then begin
         if obj_charges <= 0 then begin
            obj_charges = doc_min_charges;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
         else if obj_charges > doc_max_charges then begin
            obj_charges = doc_max_charges;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
      end
      else if objpid == PID_PARAMEDICS_BAG then begin
         if obj_charges <= 0 then begin
            obj_charges = doc_min_charges_t2;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
         else if obj_charges > doc_max_charges_t2 then begin
            obj_charges = doc_max_charges_t2;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
      end

      if user == dude_obj andAlso user_DOC <= 0 then begin
         display_msg(parse_str_2(modmsg(msg_skill_needed), objname, 0));
         set_sfall_return(0);
         return;
      end
      else if user != dude_obj andAlso user_DOC > 0 then
         user_DOC += player_level;

      if user == dude_obj andAlso (game_mod bwand INVENTORY) andAlso combat_is_initialized then begin
         display_msg(modmsg(msg_use_from_hands));
         set_sfall_return(0);
         return;
      end
      if user == dude_obj andAlso leftHand != obj andAlso rightHand != obj andAlso combat_is_initialized then begin
         display_msg(modmsg(msg_use_from_hands));
         set_sfall_return(0);
         return;
      end
      if tar_cur_hp >= tar_max_hp andAlso not(is_disabled(target)) then begin
         if user == dude_obj then begin
            if target == dude_obj then
               display_msg(modmsg(msg_dude_fullhp));
            else
               display_msg(parse_str_2(modmsg(msg_npc_fullhp), tar_name, 0));
         end
         set_sfall_return(0);
         return;
      end


      if user == dude_obj andAlso user_DOC < min_doc_cmbt andAlso combat_is_initialized then begin
         display_msg(modmsg(msg_cant_heal_limbs_combat));
         set_sfall_return(0);
         return;
      end

      if objpid == PID_PARAMEDICS_BAG then
         skill_bonus = paramedics_bag_bonus;

      //doc uninjure
      if is_disabled(target) then begin
         doc_self_dmg = 0;
         if user != dude_obj orElse (user == dude_obj andAlso user_DOC > 0 andAlso not(combat_is_initialized)) orElse (user == dude_obj andAlso user_DOC >= min_doc_cmbt andAlso combat_is_initialized) then
            call uninjure(user, target, objpid, skill_bonus);
      end
      //doc healing
      if doc_self_dmg <= 0 andAlso tar_cur_hp > 0 andAlso tar_cur_hp < tar_max_hp then begin
         if user_DOC <= 0 then user_DOC = 1;

         hp_healed = 5 + random(((skill_bonus / 10) + (user_DOC / 6)), ((skill_bonus / 4) + (user_DOC / 4))) + ceil(tar_max_hp / 600.0 * user_DOC);
         if healer_perk > 0 then hp_healed = hp_healed + random(2 * healer_perk, 5 * healer_perk);
         if hp_healed > tar_lost_hp then hp_healed = tar_lost_hp;
         if ( (user != dude_obj) orElse (user == dude_obj andAlso user_DOC > 0 andAlso not(combat_is_initialized)) orElse (user == dude_obj andAlso user_DOC >= min_doc_cmbt andAlso combat_is_initialized) ) then begin
            critter_heal(target, hp_healed);
         end
         if user == dude_obj andAlso hp_healed > 0 then begin
            display_msg(parse_str_2(modmsg(msg_dude_heal), hp_healed, 0));
         end
      end
      heal_cost = 1;
      if heal_cost > obj_charges then
         heal_cost = obj_charges;

      new_obj_charges = obj_charges - heal_cost;

      if new_obj_charges <= 0 then begin
         if user == dude_obj then begin
            display_msg(parse_str_2(modmsg(msg_item_used), objname, 0));
            if (obj == leftHand orElse obj == rightHand) andAlso not(game_mod bwand INVENTORY) then begin
               another_item = find_min_charge_obj(user, objpid, true);
               if another_item != 0 then
                  set_object_data(obj, OBJ_DATA_CUR_CHARGES, get_object_data(another_item, OBJ_DATA_CUR_CHARGES));
            end
         end
         set_sfall_return(1);
      end
      else begin
         if leftHand != obj andAlso rightHand != obj then begin
            call med_tool_split_and_set_charge(user, obj, new_obj_charges);
            set_sfall_return(1);
         end
         else begin
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, new_obj_charges);
            set_sfall_return(0);
         end
      end
      intface_redraw;
   end
   //FA
   if objpid == PID_FIRST_AID_KIT orElse objpid == PID_FIELD_MEDIC_KIT then begin
      if objpid == PID_FIRST_AID_KIT then begin
         if obj_charges <= 0 then begin
            obj_charges = max_charges;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
         else if obj_charges > max_charges then begin
            obj_charges = max_charges;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
      end
      else if objpid == PID_FIELD_MEDIC_KIT then begin
         if obj_charges <= 0 then begin
            obj_charges = max_charges_t2;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
         else if obj_charges > max_charges_t2 then begin
            obj_charges = max_charges_t2;
            set_object_data(obj, OBJ_DATA_CUR_CHARGES, obj_charges);
         end
      end

      if user == dude_obj then begin
         if user_FA <= 0 then begin
            display_msg(parse_str_2(modmsg(msg_skill_needed), objname, 0));
            set_sfall_return(0);
            return;
         end
      end
      else
         user_FA += player_level;

      if tar_cur_hp >= tar_max_hp then begin
         if user == dude_obj then begin
            if is_disabled(target) then
               display_msg(parse_str_2(modmsg(msg_use_doc_instead), objname, 0));
            else if target == dude_obj then
               display_msg(modmsg(msg_dude_fullhp));
            else
               display_msg(parse_str_2(modmsg(msg_npc_fullhp), tar_name, 0));
         end
         set_sfall_return(0);
         return;
      end

      if objpid == PID_FIELD_MEDIC_KIT then
         skill_bonus = field_medic_kit_bonus;

      hp_healed = random(((skill_bonus / 10) + (user_FA / 9)), ((skill_bonus / 4) + (user_FA / 5)));
      if hp_healed <= 0 then hp_healed = 1;
      if healer_perk > 0 then hp_healed = hp_healed + random(2 * healer_perk, 5 * healer_perk);
      if hp_healed > tar_lost_hp then
         hp_healed = tar_lost_hp;

      if tar_cur_hp < tar_max_hp then begin
         critter_heal(target, hp_healed);
         if heal_cost > obj_charges then
            heal_cost = obj_charges;

         new_obj_charges = obj_charges - heal_cost;
         if user == dude_obj then
            display_msg(parse_str_2(modmsg(msg_dude_heal), hp_healed, 0));

         if new_obj_charges <= 0 then begin
            if user == dude_obj then begin
               display_msg(parse_str_2(modmsg(msg_item_used), objname, 0));
               if (obj == leftHand orElse obj == rightHand) andAlso not(game_mod bwand INVENTORY) then begin
                  another_item = find_min_charge_obj(user, objpid, true);
                  if another_item != 0 then
                     set_object_data(obj, OBJ_DATA_CUR_CHARGES, get_object_data(another_item, OBJ_DATA_CUR_CHARGES));
               end
            end
            set_sfall_return(1);
         end
         else begin
            if leftHand != obj andAlso rightHand != obj then begin
               call med_tool_split_and_set_charge(user, obj, new_obj_charges);
               set_sfall_return(1);
            end
            else begin
               set_object_data(obj, OBJ_DATA_CUR_CHARGES,new_obj_charges);
               set_sfall_return(0);
            end
         end
         intface_redraw;
      end
   end
end

procedure USESKILL begin
   variable user = get_sfall_arg;
   variable tar = get_sfall_arg;
   variable skill = get_sfall_arg;
   if skill == SKILL_FIRST_AID orElse skill == SKILL_DOCTOR then begin
      if obj_type(tar) != OBJ_TYPE_CRITTER then begin
         display_msg(modmsg(msg_useless_act));
         set_sfall_return(0);
         return false;
      end
      if obj_type(tar) == OBJ_TYPE_CRITTER andAlso is_critter_dead(tar) then begin
         display_msg(modmsg(msg_target_is_dead));
         set_sfall_return(0);
         return false;
      end
   end
end

//copied from Phobos2077 ecco mod https://github.com/phobos2077/fo2_ecco/blob/master/scripts_src/_pbs_main/gl_pbs_healing_skills.ssl
procedure DESCRIPTIONOBJ begin
   variable
      obj := get_sfall_arg,
      objPid := obj_pid(obj),
      str, curCharges, maxCharges;

   if (obj_type(obj) != OBJ_TYPE_ITEM) then
      return;
   curCharges = med_item_get_or_restore_charges(obj);
   if (curCharges <= 0 ) then
      return;
   str := string_format(modmsg(msg_uses_left), curCharges, get_proto_data(objPid, PROTO_MI_CHARGES));
   set_sfall_return(proto_data(objPid, it_description) + str);
end


procedure ecco_heal_mod_handler begin
   variable disable_ecco;
   disable_ecco = message_box(
      modmsg(msg_ecco_healing_1)+"\n"
      + modmsg(msg_ecco_healing_2)+"\n"
      + modmsg(msg_ecco_healing_3)+"\n"
      + modmsg(msg_ecco_healing_4)+"\n"
      + modmsg(msg_ecco_healing_5));
   return disable_ecco;
end

procedure game_exit_to_menu begin
   write_byte(0x481B2A, 0xB8);
   write_int(0x481B2B, 27);
   sfall_func0("signal_close_game");
end

procedure non_combat_npc_heal_self begin
   variable critters_arr;
   variable critter;
   variable injuried;
   variable party;
   variable critter_cur_frm;
   variable doc_item;
   variable fa_item;
   variable cur_hp;
   variable max_hp;
   variable state;
   variable target_critter;
   variable target_item;
   variable found_target;
   variable last_found_critter;
   variable last_found_item;
   variable has_item;
   variable total;
   variable i;
   variable reverse;
   variable critter_hr;

   critters_arr = list_as_array(LIST_CRITTERS);
   if NPCsUseMedTools < 3 then
      party = party_member_list(1);

   total = len_array(critters_arr);
   reverse = random(0, 1);

   for (i = 0; i < total; i++) begin
      if reverse then
         critter = critters_arr[total - 1 - i];
      else
         critter = critters_arr[i];

      if critter == dude_obj orElse not(obj_is_visible_flag(critter)) then
         continue;

      if (NPCsUseMedTools < 3 andAlso is_in_array(critter, party)) orElse not(can_use_items(critter_kill_type(critter))) then
         continue;

      if get_array(heal_map, critter) != 0 then
         continue;

      critter_cur_frm = get_object_data(critter, OBJ_DATA_CUR_FRM);
      if critter_cur_frm != 0 orElse anim_busy(critter) != 0 then
         continue;

      injuried = is_disabled(critter);
      cur_hp = get_critter_stat(critter, STAT_current_hp);
      max_hp = get_critter_stat(critter, STAT_max_hp);
      state = critter_state(critter);

      if is_really_dead(critter, state, cur_hp) then
         continue;

      doc_item = 0;
      fa_item = 0;
      has_item = 0;

      if injuried then begin
         doc_item = find_min_charge_obj(critter, doc_bag_pid);
         if not(doc_item) then begin
            doc_item = find_min_charge_obj(critter, PID_PARAMEDICS_BAG);
            if not(doc_item) andAlso StimUninjure > 0 andAlso cur_hp < max_hp - 30 then begin
               doc_item = obj_carrying_pid_obj(critter, PID_SUPER_STIMPAK);
            end
         end


         if doc_item then
            has_item = true;
      end

      if not(has_item) andAlso cur_hp < max_hp - 10 then begin
         fa_item = find_min_charge_obj(critter, PID_FIRST_AID_KIT);
         if not(fa_item) then begin
            fa_item = find_min_charge_obj(critter, PID_FIELD_MEDIC_KIT);
            if not(fa_item) then begin
               if RegenMod <= 0 then begin
                  if cur_hp < max_hp then begin
                     fa_item = obj_carrying_pid_obj(critter, PID_STIMPAK);
                     if not(fa_item) then begin
                        fa_item = obj_carrying_pid_obj(critter, PID_HEALING_POWDER);
                        if not(fa_item) andAlso cur_hp < max_hp - 15 then
                           fa_item = obj_carrying_pid_obj(critter, PID_SUPER_STIMPAK);
                     end
                  end
               end
               else if RegenMod > 0 then begin
                  critter_hr = get_critter_stat(critter, STAT_heal_rate) + get_critter_extra_stat(critter, STAT_heal_rate);
                  if critter_hr <= 20 then begin
                     if critter_hr >= -1 then begin
                        fa_item = obj_carrying_pid_obj(critter, PID_HEALING_POWDER);
                        if not(fa_item) then
                           fa_item = obj_carrying_pid_obj(critter, PID_STIMPAK);
                     end
                     else if critter_hr >= -14 then
                        fa_item = obj_carrying_pid_obj(critter, PID_STIMPAK);
                  end
               end
            end
         end

         if fa_item then
            has_item = true;
      end

      if not(has_item) then
         continue;

      last_found_critter = critter;
      if doc_item then
         last_found_item = doc_item;
      else if fa_item then
         last_found_item = fa_item;

      found_target = true;
      target_critter = critter;
      if doc_item then
         target_item = doc_item;
      else if fa_item then
         target_item = fa_item;
      break;
   end

   if found_target andAlso target_critter andAlso target_item then begin
      anim(target_critter, ANIM_magic_hands_middle, ANIMATE_FORWARD);
      set_self(target_critter);
      set_self(target_critter);
      use_obj_on_obj(target_item, target_critter);
      set_self(0);


      set_array(heal_map, target_critter, target_item);
      return 1;
   end


   if last_found_critter andAlso last_found_item then begin
      clear_array(heal_map);

      anim(last_found_critter, ANIM_magic_hands_middle, ANIMATE_FORWARD);
      set_self(last_found_critter);
      set_self(last_found_critter);
      use_obj_on_obj(last_found_item, last_found_critter);
      set_self(0);

      set_array(heal_map, last_found_critter, last_found_item);
      return 1;
   end

   clear_array(heal_map);
   return 0;
end

procedure timed_event_p_proc begin
   variable param = fixed_param;
   variable game_mode = get_game_mode;
   variable healed;
   variable time;
   if NPCsUseMedTools < 1 then
      return;
   if timed_event_heal_out_of_combat then begin
      if combat_is_initialized then
         time = 65;
      else if game_mode == 0 then begin
         healed = non_combat_npc_heal_self;
         if healed then
            time = random(5, 25);
         else
            time = random(25, 75);
      end
      else if game_mode bwand WORLDMAP then begin
         heal_timer_needs_reset = 1;
      end
      else if game_mode bwand PIPBOY then begin
         heal_timer_needs_reset = 1;
         time = 30000;
      end

      if time != 0 then begin
         add_global_timer_event(time, timed_event_heal_out_of_combat);
      end
   end
end

procedure start begin
   variable ECCO_heal_tweak;
   variable was_disabled;
   variable sfall_ver_maj,ver_minor,ver_build;
   if game_loaded then begin
      MedToolsMod = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|MedToolsMod");
      ECCO_heal_tweak = get_ini_setting(ECCO_HEALING_SKILLS+"skill_use_mod");
      Sonora = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|Sonora");

      //CHECK AND SET INVEN AP COST
      //check EcCo
      inven_use_ap_cost = get_ini_setting(ECCO_APCOST);
      if inven_use_ap_cost > 0 then begin
         if get_ini_string("mods\\F2MechanicsMiniRework.ini|Main|inv_ap_cost") == "" then begin
            set_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|inv_ap_cost", 2);
         end
         inven_use_ap_cost = 2;
         if get_ini_string("mods\\F2MechanicsMiniRework.ini|Main|qp_discount") == "" then begin
            set_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|qp_discount", 1);
         end
         inven_use_ap_cost_quick_pockets_discount = 1;
         inven_use_ap_cost_min = 0;
         if get_ini_string("mods\\F2MechanicsMiniRework.ini|Main|min_ap_cost") == "" then begin
            set_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|min_ap_cost", inven_use_ap_cost_min);
         end
      end
      //check Inventory AP Cost Mk II
      else begin
         inven_use_ap_cost = get_ini_setting(Inventory_AP_Cost_ini_AP);
         if inven_use_ap_cost > 0 then begin
            if get_ini_string("mods\\F2MechanicsMiniRework.ini|Main|inv_ap_cost") == ""  then begin
               set_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|inv_ap_cost", inven_use_ap_cost);
            end
            inven_use_ap_cost_quick_pockets_discount = get_ini_setting(Inventory_AP_Cost_ini_QP);
            if get_ini_string("mods\\F2MechanicsMiniRework.ini|Main|qp_discount") == "" then begin
               set_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|qp_discount", inven_use_ap_cost_quick_pockets_discount);
            end
            inven_use_ap_cost_min = 1;
            if get_ini_string("mods\\F2MechanicsMiniRework.ini|Main|min_ap_cost") == "" then begin
               set_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|min_ap_cost", inven_use_ap_cost_min);
            end
         end
         //check MMR
         else begin
            inven_use_ap_cost = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|inv_ap_cost");
            inven_use_ap_cost_quick_pockets_discount = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|qp_discount");
            inven_use_ap_cost_min = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|min_ap_cost");
         end
      end

      if Sonora > 0 then begin
         doc_bag_pid = Sonora_doc_bag_pid;
      end
      if MedToolsMod > 0 then begin
         heal_map = create_array_map;
         new_mod_msg = add_extra_msg_file(msg_file);
         if ECCO_heal_tweak > 0 then begin
            if ecco_heal_mod_handler <= 0 then begin
               set_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|MedToolsMod", 0);
            end
            else begin
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_use_mod", 0);
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_91", 0);
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_47", 0);
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_409", 0);
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_408", 0);
            end
            call game_exit_to_menu in 1;
            return;
         end
         else begin
            ECCO_heal_tweak = get_ini_string(ECCO_HEALING_SKILLS+"skill_item_91");
            if ECCO_heal_tweak != "" andAlso ECCO_heal_tweak != "0" then
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_91", 0);

            ECCO_heal_tweak = get_ini_string(ECCO_HEALING_SKILLS+"skill_item_47");
            if ECCO_heal_tweak != "" andAlso ECCO_heal_tweak != "0" then
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_47", 0);

            ECCO_heal_tweak = get_ini_string(ECCO_HEALING_SKILLS+"skill_item_409");
            if ECCO_heal_tweak != "" andAlso ECCO_heal_tweak != "0" then
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_409", 0);

            ECCO_heal_tweak = get_ini_string(ECCO_HEALING_SKILLS+"skill_item_408");
            if ECCO_heal_tweak != "" andAlso ECCO_heal_tweak != "0" then
               set_ini_setting(ECCO_HEALING_SKILLS+"skill_item_408", 0);

         end


         set_global_script_type(0);
         set_global_script_repeat(0);

         sfall_ver_maj = sfall_ver_major;
         ver_minor = sfall_ver_minor;
         ver_build = sfall_ver_build;

         if sfall_ver_maj >= 5 then begin
            if sfall_ver_maj > 5 orElse ver_minor > 0 then begin
               //sfall_510 = 1;
//
               //if sfall_ver_maj > 5 orElse ver_minor > 1 orElse (ver_minor == 1 andAlso ver_build >= 5) then begin
                  //sfall_515 = 1;
               //end

               unsafe_script;
            end
         end

         RegenMod = get_ini_setting ("mods\\F2MechanicsMiniRework.ini|Main|RegenMod");
         if RegenMod > 0 then
            StimUninjure = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Regeneration|StimUninjure");

         NPCsUseMedTools = get_ini_setting("mods\\F2MechanicsMiniRework.ini|MedToolsMod|NPCsUseMedTools");
         DisableRepairTools = get_ini_setting("mods\\F2MechanicsMiniRework.ini|MedToolsMod|DisableRepairTools");
         ET_TU = get_ini_setting("mods\\F2MechanicsMiniRework.ini|Main|et_tu");

         if Sonora <= 0 andAlso ET_TU <= 0 then begin
            //Fallout_2 = 1;
            //if get_proto_data(542, PROTO_FID) == 197 then begin
               //Megamod = 1;
            //end
            if get_proto_data(595, PROTO_FID) == 171 then begin
               Olympus2207 = 1;
               tool_pid = 83;
               super_tool_pid = 301;
            end
         end

         sfall_mods_config = get_ini_string("ddraw.ini|Scripts|IniConfigFolder");
         if sfall_mods_config <= 0 then sfall_mods_config = "";
         combat_direct_controll = get_ini_setting(sfall_mods_config+"\\sfall-mods.ini|CombatControl|Mode");
         register_hook_proc(HOOK_CALCAPCOST, CALCAPCOST);
         register_hook_proc(HOOK_USEOBJON, USEOBJON);
         if inven_use_ap_cost > 0 then begin
            register_hook_proc(HOOK_USEOBJ, USEOBJ);
            register_hook_proc(HOOK_INVENTORYMOVE, INVENTORYMOVE);
         end
         register_hook_proc(HOOK_USESKILL, USESKILL);
         register_hook_proc(HOOK_COMBATTURN, COMBATTURN);
         register_hook_proc(HOOK_REMOVEINVENOBJ, REMOVEINVENOBJ);
         register_hook_proc(HOOK_GAMEMODECHANGE, GAMEMODECHANGE);
         register_hook_proc(HOOK_DESCRIPTIONOBJ, DESCRIPTIONOBJ);

         add_global_timer_event(11, timed_event_heal_out_of_combat);
         call map_enter_p_proc();
         call med_item_charges_restore;
         intface_redraw;
      end
      else begin
         if MedToolsMod != -1 andAlso ECCO_heal_tweak <= 0 then begin
            if get_proto_data(PID_FIRST_AID_KIT, PROTO_MI_CHARGES) == max_charges then begin
               set_proto_data(PID_FIRST_AID_KIT, PROTO_MI_CHARGES, 0);
               was_disabled = 1;
            end

            if get_proto_data(PID_FIELD_MEDIC_KIT, PROTO_MI_CHARGES) == max_charges_t2 then begin
               set_proto_data(PID_FIELD_MEDIC_KIT, PROTO_MI_CHARGES, 0);
               was_disabled = 1;
            end
            if get_proto_data(doc_bag_pid, PROTO_MI_CHARGES) == doc_max_charges then begin
               set_proto_data(doc_bag_pid, PROTO_MI_CHARGES, 0);
               was_disabled = 1;
            end

            if get_proto_data(PID_PARAMEDICS_BAG, PROTO_MI_CHARGES) == doc_max_charges_t2 then begin
               set_proto_data(PID_PARAMEDICS_BAG, PROTO_MI_CHARGES, 0);
               was_disabled = 1;
            end
         end
         if was_disabled then
            intface_redraw;
         exit;
      end
   end
end
