   if cur_hp >= max_hp then begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate_reverse(gCritter, ANIM_throw_punch, 0);
      reg_anim_play_sfx(gCritter,sfx_build_char_name(gCritter,ANIM_throw_punch,snd_contact), 0);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end
end

procedure reg_anim_combat_robot_repair_another_target(variable critter, variable target, variable ap_cost, variable count, variable self_heal) begin
   variable i;
   variable animate2 = 1;
   variable enemy_target;
   if count > 10 then
      count = 10;
   gCritter = critter;
   gTarget = target;
   gApCost = ap_cost;
   gItemPid = -1;

   reg_anim_combat_check(0);
   reg_anim_clear_forced(gCritter, 1);
   reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
   reg_anim_animate(gCritter, ANIM_throw_punch, 0);
   reg_anim_play_sfx(gCritter,sfx_build_char_name(gCritter,ANIM_throw_punch,snd_contact), 0);
   reg_anim_obj_run_to_obj(gCritter, target, -1);
   reg_anim_turn_towards(gCritter, tile_num_in_direction(tile_num(target), rotation_to_tile(tile_num(critter),tile_num(target)),1), -1);
   for (i := 0; i < count; i++) begin
      if animate2 then begin
         if animate2 == 1 then begin
            reg_anim_callback(g_use_repair_on_target_punch_last_target);
            reg_anim_animate(gCritter, ANIM_throw_punch, -1);
            reg_anim_play_sfx(gCritter,sfx_build_char_name(gCritter,ANIM_throw_punch,snd_contact), 0);
            animate2 = 2;
         end
         else if count > 1 then begin
            reg_anim_callback(g_use_repair_on_target_revers_last_target);
            reg_anim_animate_reverse(gCritter, ANIM_throw_punch, -1);
            reg_anim_play_sfx(gCritter,sfx_build_char_name(gCritter,ANIM_throw_punch,snd_contact), 0);
            animate2 = 1;
         end
      end
   end
   reg_anim_end();
   call ai_allow_continue_turn(gCritter);
end

procedure g_use_repair_on_target_revers begin
   variable cur_ap;
   variable cur_hp;
   variable max_hp;
   variable cur_enemy;
   variable another_target;
   if gCritter == 0 orElse gTarget == 0 then
      return;
   cur_ap = get_critter_current_ap(gCritter);

   if cur_ap >= gApCost then begin
      call do_repair(gCritter, gTarget, 30);
      set_critter_current_ap(gCritter, (cur_ap - gApCost));
      display_msg(parse_str_2(modmsg(msg_npc_repairs_target), obj_name(gCritter), obj_name(gTarget)));
      if gTarget != dude_obj then
         critter_set_flee_state(gTarget, 0);
      cur_enemy = get_object_data(gCritter, OBJ_DATA_WHO_HIT_ME);
      if cur_enemy != 0 andAlso get_object_data(gTarget, OBJ_DATA_WHO_HIT_ME) == 0 then
         set_object_data(gTarget, OBJ_DATA_WHO_HIT_ME, cur_enemy);
      set_object_data(gTarget, OBJ_DATA_COMBAT_STATE, get_object_data(gTarget, OBJ_DATA_COMBAT_STATE) bwor 1);
   end
   else begin
      reg_anim_combat_check(0);
      reg_anim_clear_forced(gCritter, 1);
      reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
      reg_anim_animate(gCritter, ANIM_stand, 0);
      reg_anim_animate_reverse(gCritter, ANIM_stand, 1);
      reg_anim_end();
      call ai_allow_continue_turn(gCritter);
   end

   cur_hp = get_critter_stat(gTarget, STAT_current_hp);
   max_hp = get_critter_stat(gTarget, STAT_max_hp);
   if cur_hp >= max_hp orElse (cur_ap >= gApCost) then begin
      if cur_ap >= gApCost then
         another_target = ai_search_wounded_friend(gCritter, gApCost, true, true, gTarget);
      if another_target then begin
         call reg_anim_combat_robot_repair_another_target(gCritter, another_target, gApCost, random(1, 2), false);
      end
      else begin
         reg_anim_combat_check(0);
         reg_anim_clear_forced(gCritter, 1);
         reg_anim_func(REG_ANIM_BEGIN, RB_RESERVED);
         reg_anim_animate_reverse(gCritter, ANIM_throw_punch, 0);
         reg_anim_play_sfx(gCritter,sfx_build_char_name(gCritter,ANIM_throw_punch,snd_contact), 0);
         reg_anim_end();
         call ai_allow_continue_turn(gCritter);
      end
   end
end

